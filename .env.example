# ─────────────────────────────────────────────────────────────
# Public-site environment variables
# (PUBLIC_* prefix is required by Astro for client-bundled vars)
# ─────────────────────────────────────────────────────────────

# MapTiler Cloud key — free tier 100k loads/month
# Get one at https://cloud.maptiler.com/account/keys/
# Optional: if absent, the app falls back to raw OpenStreetMap tiles.
PUBLIC_MAPTILER_KEY=
