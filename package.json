{
  "name": "@landx/public-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 5180",
    "build": "astro build && node scripts/postbuild-rewrite-base.mjs",
    "preview": "astro preview --port 5180",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "pnpm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "sourcemap:upload": "echo 'Sentry CLI integration: source maps would upload here when DSN configured (e.g. sentry-cli sourcemaps upload --release $RELEASE dist/_astro)'"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.0",
    "@fontsource/roboto": "^5.2.10",
    "@landx/ai": "workspace:*",
    "@landx/data": "workspace:*",
    "@landx/icons": "workspace:*",
    "@landx/ui": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.100.9",
    "astro": "^6.0.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "satori": "^0.26.0",
    "tailwindcss": "^4.2.4",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.11.3",
    "@landx/eslint-config": "workspace:*",
    "@landx/tsconfig": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.5"
  }
}
