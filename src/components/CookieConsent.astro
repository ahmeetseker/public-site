---
// Wave F13.D — Cookie consent banner (sticky bottom).
//
// Renders 3 actions: "Accept all" / "Essential only" / "Customize".
// The Customize button toggles a `cookie-consent:open-modal` window event;
// CookieConsentModal (React island) listens for it.
//
// Visibility:
//   - Hidden by default via `hidden` attribute + `data-cc-banner="closed"`.
//   - Inline <script> at end of <body>: if no decision recorded, drop the
//     `hidden` attribute and animate the banner in. After any choice, banner
//     hides itself; we DO NOT cause layout shift (uses transform-only entry).

import { t, type Locale } from '@/i18n'

export interface Props {
  locale: Locale
}

const { locale } = Astro.props

const title = t('cookieConsent.banner.title', locale)
const body = t('cookieConsent.banner.body', locale)
const acceptAll = t('cookieConsent.banner.acceptAll', locale)
const rejectAll = t('cookieConsent.banner.rejectAll', locale)
const customize = t('cookieConsent.banner.customize', locale)
const learnMore = t('cookieConsent.banner.learnMore', locale)
const policyHref = locale === 'en' ? '/en/cookie-policy' : '/cerez-politikasi'
---

<aside
  id="cookie-consent-banner"
  data-cc-banner="closed"
  data-testid="cookie-consent-banner"
  aria-label={title}
  aria-live="polite"
  hidden
  class="fixed inset-x-0 bottom-0 z-50 translate-y-full border-t border-border bg-background/95 shadow-[0_-8px_32px_-12px_rgba(0,0,0,0.25)] backdrop-blur transition-transform duration-300 ease-out data-[cc-banner=open]:translate-y-0"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-5 sm:flex-row sm:items-center sm:gap-6 sm:px-6">
    <div class="flex-1">
      <h2 class="font-serif text-lg font-normal tracking-tight text-foreground">
        {title}
      </h2>
      <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
        {body}{' '}
        <a
          href={policyHref}
          class="font-medium text-foreground underline-offset-4 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-foreground/40 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          {learnMore}
        </a>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2 sm:flex-nowrap">
      <button
        type="button"
        data-cc-action="customize"
        data-testid="cookie-consent-customize"
        class="rounded-full border border-border bg-background px-4 py-2 font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground transition hover:bg-accent hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-foreground/40"
      >
        {customize}
      </button>
      <button
        type="button"
        data-cc-action="reject"
        data-testid="cookie-consent-reject"
        class="rounded-full border border-border bg-background px-4 py-2 font-mono text-xs uppercase tracking-[0.14em] text-foreground transition hover:bg-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-foreground/40"
      >
        {rejectAll}
      </button>
      <button
        type="button"
        data-cc-action="accept"
        data-testid="cookie-consent-accept"
        class="rounded-full border border-foreground bg-foreground px-4 py-2 font-mono text-xs uppercase tracking-[0.14em] text-background transition hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-foreground/40 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
      >
        {acceptAll}
      </button>
    </div>
  </div>
</aside>

<script>
  // Wire the banner buttons + visibility against the cookie-consent storage.
  // Lives inline so it runs on the first paint without an additional module.
  import {
    EVENT_NAME,
    acceptAll,
    getConsent,
    rejectAll,
  } from '@/lib/cookie-consent'

  const banner = document.getElementById('cookie-consent-banner')
  if (banner) {
    function show() {
      banner!.hidden = false
      // RAF so the initial `translate-y-full` style is applied before we
      // switch the data attribute that triggers the slide-in transition.
      requestAnimationFrame(() => {
        banner!.dataset.ccBanner = 'open'
      })
    }
    function hide() {
      banner!.dataset.ccBanner = 'closed'
      window.setTimeout(() => {
        if (banner!.dataset.ccBanner === 'closed') banner!.hidden = true
      }, 320)
    }

    // Initial visibility — show only when undecided.
    if (getConsent() === null) show()

    banner.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null
      const action = target?.closest<HTMLElement>('[data-cc-action]')?.dataset.ccAction
      if (!action) return
      if (action === 'accept') {
        acceptAll()
        hide()
      } else if (action === 'reject') {
        rejectAll()
        hide()
      } else if (action === 'customize') {
        window.dispatchEvent(new CustomEvent('cookie-consent:open-modal'))
      }
    })

    // React to changes from the modal (or other surfaces) — hide once decided.
    window.addEventListener(EVENT_NAME, () => {
      hide()
    })
  }
</script>
