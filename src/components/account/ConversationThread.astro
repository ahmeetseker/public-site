---
import type { BuyerConversation } from '@landx/data'
import { timeAgo } from '@landx/ui/lib'

export interface Props {
  conversation: BuyerConversation
}

const { conversation } = Astro.props
---
<div class="flex h-full flex-col rounded-2xl border border-border bg-card">
  <!-- Thread header -->
  <header class="flex items-start justify-between gap-3 border-b border-border px-5 py-4">
    <div class="min-w-0 flex-1">
      <div class="flex items-baseline gap-2">
        <h3 class="truncate font-serif text-lg tracking-tight">{conversation.office}</h3>
        <a
          href={`/ofis/${conversation.officeSlug}`}
          class="text-xs text-muted-foreground underline underline-offset-2 hover:text-foreground"
        >
          Ofis profili
        </a>
      </div>
      <a
        href={`/ilan/${conversation.listingId}`}
        class="mt-1 inline-flex items-center gap-2 text-xs text-muted-foreground hover:text-foreground"
      >
        <span class="font-mono text-xs uppercase tracking-wide">{conversation.listingId}</span>
        <span class="truncate">{conversation.listingTitle}</span>
      </a>
    </div>
  </header>

  <!-- Messages -->
  <div class="flex flex-1 flex-col gap-3 overflow-y-auto px-5 py-5">
    {conversation.messages.map((m) => {
      const isMe = m.from === 'me'
      return (
        <div class={`flex ${isMe ? 'justify-end' : 'justify-start'}`}>
          <div class="flex max-w-[78%] flex-col gap-1">
            <div
              class={`rounded-2xl px-4 py-2.5 text-sm leading-relaxed ${
                isMe
                  ? 'rounded-br-sm bg-accent text-accent-foreground'
                  : 'rounded-bl-sm border border-border bg-background'
              }`}
            >
              {m.text}
            </div>
            <time
              datetime={m.at}
              class={`font-mono text-xs text-muted-foreground ${isMe ? 'text-right' : 'text-left'}`}
            >
              {timeAgo(m.at)}
            </time>
          </div>
        </div>
      )
    })}
  </div>

  <!-- Composer (placeholder) -->
  <form
    id="msg-composer-form"
    class="flex items-center gap-2 border-t border-border px-5 py-3"
  >
    <label class="sr-only" for="msg-input">Mesajını yaz</label>
    <input
      id="msg-input"
      type="text"
      placeholder="Mesajını yaz…"
      class="flex-1 rounded-xl border border-border bg-background px-3 py-2 text-sm placeholder:text-[hsl(var(--placeholder))] focus:border-foreground/30 focus:outline-none focus:ring-2 focus:ring-foreground/10"
    />
    <button
      type="submit"
      class="inline-flex items-center rounded-xl bg-accent px-3.5 py-2 text-sm font-medium text-accent-foreground transition-opacity hover:opacity-90"
    >
      Gönder
    </button>
  </form>
</div>

<script is:inline>
  (function () {
    const form = document.getElementById('msg-composer-form')
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault()
        alert("Mesaj gönderme Faz 10.2'de aktif olacak.")
      })
    }
  })()
</script>
