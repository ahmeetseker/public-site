---
import type { SavedSearch } from '@landx/data'
import { formatTLCompact } from '@landx/ui/lib'

export interface Props {
  search: SavedSearch
}

const { search } = Astro.props

// Pretty filter chips
const filterChips: string[] = []
if (search.filters.tip && search.filters.tip !== 'Tümü') filterChips.push(String(search.filters.tip))
if (search.filters.il) filterChips.push(String(search.filters.il))
if (typeof search.filters.priceMax === 'number') {
  filterChips.push(`≤ ${formatTLCompact(search.filters.priceMax)}`)
}
if (search.q) filterChips.push(`"${search.q}"`)

// Build a search URL so "Aramayı çalıştır" links back to /ara with the criteria.
const params = new URLSearchParams()
if (search.q) params.set('q', search.q)
if (search.filters.tip && search.filters.tip !== 'Tümü') params.set('tip', String(search.filters.tip))
if (search.filters.il) params.set('il', String(search.filters.il))
if (typeof search.filters.priceMax === 'number') params.set('priceMax', String(search.filters.priceMax))
const runHref = `/ara?${params.toString()}`

const lastRunFormatted = new Date(search.lastRun).toLocaleDateString('tr-TR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
})
---
<article class="flex flex-col gap-3 rounded-2xl border border-border bg-card p-4 md:flex-row md:items-center md:gap-4">
  <div class="min-w-0 flex-1">
    <div class="flex items-baseline gap-2">
      <h3 class="truncate font-serif text-base tracking-tight">{search.name}</h3>
      {search.matchCount > 0 && (
        <span class="inline-flex items-center rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-medium text-emerald-700 dark:bg-emerald-400/10 dark:text-emerald-300">
          {search.matchCount} eşleşme
        </span>
      )}
    </div>
    {filterChips.length > 0 && (
      <div class="mt-1.5 flex flex-wrap gap-1.5">
        {filterChips.map((c) => (
          <span class="rounded-full bg-foreground/5 px-2 py-0.5 text-xs text-muted-foreground">
            {c}
          </span>
        ))}
      </div>
    )}
    <div class="mt-1.5 font-mono text-xs uppercase tracking-wide text-muted-foreground">
      Son çalıştırma: {lastRunFormatted}
    </div>
  </div>

  <div class="flex items-center gap-3 md:flex-col md:items-end md:gap-2">
    <label class="flex items-center gap-2 text-xs text-muted-foreground" title="Bildirim aç/kapat (demo)">
      <input
        type="checkbox"
        checked={search.alerts}
        class="h-4 w-4 rounded border-border accent-foreground"
        aria-label={`${search.name} için e-posta bildirimi`}
      />
      <span>Bildirim</span>
    </label>
    <div class="flex items-center gap-2">
      <a
        href={runHref}
        class="rounded-full border border-border bg-background px-3 py-1.5 text-xs font-medium transition hover:bg-foreground/5"
      >
        Aramayı aç
      </a>
      <button
        type="button"
        data-delete-search={search.id}
        class="rounded-full px-2 py-1.5 text-xs text-muted-foreground transition hover:bg-rose-500/10 hover:text-rose-600 dark:hover:text-rose-400"
        aria-label={`${search.name} aramasını sil`}
      >
        Sil
      </button>
    </div>
  </div>
</article>
