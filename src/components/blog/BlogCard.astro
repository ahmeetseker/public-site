---
// Wave F8 / Agent-F8A — Blog list card.
// Used by /blog and /en/blog hub pages. Pure presentational Astro component
// (no JS island) since the listing is static at build time.
import type { BlogPost } from '@/lib/blog'
import { blogHref, postSlug } from '@/lib/blog'
import { t, type Locale } from '@/i18n'

export interface Props {
  post: BlogPost
  locale: Locale
}

const { post, locale } = Astro.props
const slug = postSlug(post)
const href = blogHref(slug, locale)
const title = locale === 'en' ? post.data.titleEn : post.data.title
const description = locale === 'en' ? post.data.descriptionEn : post.data.description
const categoryLabel = t(`blog.categories.${post.data.category}`, locale)
// Date display: localized short form (deterministic) — `Intl.DateTimeFormat`
// is timezone-stable when given a Date and a fixed locale.
const dateFmt = new Intl.DateTimeFormat(locale === 'en' ? 'en-US' : 'tr-TR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
const dateLabel = dateFmt.format(post.data.date)
---
<article
  class="group flex flex-col gap-3 rounded-2xl border border-border bg-card/40 p-5 transition hover:bg-card"
  data-testid="blog-card"
  data-category={post.data.category}
>
  <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-[0.18em] text-muted-foreground">
    <span class="rounded-full bg-accent/40 px-2 py-0.5 text-foreground/80">{categoryLabel}</span>
    <time datetime={post.data.date.toISOString()}>{dateLabel}</time>
  </div>
  <h2 class="font-serif text-xl font-medium tracking-tight md:text-2xl">
    <a href={href} class="transition group-hover:underline underline-offset-4 decoration-1">
      {title}
    </a>
  </h2>
  <p class="text-sm leading-relaxed text-muted-foreground line-clamp-3">
    {description}
  </p>
  {post.data.tags.length > 0 && (
    <ul class="mt-1 flex flex-wrap gap-1.5">
      {post.data.tags.slice(0, 4).map((tag) => (
        <li class="rounded-full border border-border bg-background px-2 py-0.5 text-xs text-muted-foreground">
          #{tag}
        </li>
      ))}
    </ul>
  )}
</article>
