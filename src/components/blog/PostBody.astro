---
// Wave F8 / Agent-F8A — Blog post body.
// The caller passes the rendered <Content /> from `entry.render()`. We wrap it
// in a `prose`-ish container with Tailwind utilities matching the rest of the
// site (no `@tailwindcss/typography` plugin — we hand-roll a minimal article
// rhythm here to stay dependency-free).
---
<div
  class="post-body max-w-[68ch] text-base leading-[1.75] text-foreground/90"
  data-testid="post-body"
>
  <slot />
</div>

<style>
  .post-body :global(h2) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.3;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }
  .post-body :global(h3) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.2rem;
    line-height: 1.35;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .post-body :global(p) {
    margin-bottom: 1.1rem;
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 1.1rem 1.25rem;
    padding-left: 1rem;
  }
  .post-body :global(ul) { list-style: disc outside; }
  .post-body :global(ol) { list-style: decimal outside; }
  .post-body :global(li) {
    margin-bottom: 0.4rem;
  }
  .post-body :global(a) {
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }
  .post-body :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .post-body :global(strong) {
    font-weight: 600;
    color: var(--color-foreground);
  }
  .post-body :global(blockquote) {
    border-left: 3px solid var(--color-border);
    margin: 1.25rem 0;
    padding: 0.25rem 0 0.25rem 1rem;
    color: var(--color-muted-foreground);
    font-style: italic;
  }
  .post-body :global(code) {
    background: var(--color-accent);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-size: 0.92em;
    font-family: var(--font-mono);
  }
</style>
