---
import type { Region } from '@landx/data'
import { LISTINGS } from '@landx/data'

export interface Props {
  regions: Region[]
}

const { regions } = Astro.props

const cards = regions.map((r) => ({
  ...r,
  count: LISTINGS.filter((l) => r.match(l.district)).length,
}))
---

{
  cards.length > 0 && (
    <section class="border-t border-border bg-card/40">
      <div class="mx-auto max-w-[1280px] px-4 py-16 md:py-20">
        <div class="mb-8">
          <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
            BENZER BÖLGELER
          </div>
          <h2 class="mt-2 font-serif text-3xl font-normal tracking-tight md:text-4xl">
            Profilinize <em class="font-serif italic font-normal">yakın</em> bölgeler
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {cards.map((r) => (
            <a
              href={`/bolge/${r.slug}`}
              class="group flex flex-col justify-between rounded-2xl border border-border bg-card p-6 transition hover:bg-accent hover:text-accent-foreground"
            >
              <div>
                <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground group-hover:text-accent-foreground/70">
                  {r.city}
                </div>
                <div class="mt-1 font-serif text-2xl font-normal tracking-tight">{r.name}</div>
                <p class="mt-3 line-clamp-2 text-sm text-muted-foreground group-hover:text-accent-foreground/80">
                  {r.description}
                </p>
              </div>
              <div class="mt-6 flex items-center justify-between">
                <span class="text-xs text-muted-foreground group-hover:text-accent-foreground/70">
                  {r.count} ilan
                </span>
                <svg
                  class="h-3.5 w-3.5 text-muted-foreground transition group-hover:translate-x-0.5 group-hover:text-accent-foreground"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
