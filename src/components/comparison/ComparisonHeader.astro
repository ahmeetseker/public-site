---
export interface Props {
  count: number
  hasInvalidIds: boolean
}
const { count, hasInvalidIds } = Astro.props
---
<header class="mb-6">
  <div class="mb-1 font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">KARŞILAŞTIRMA</div>
  <h1 class="font-serif text-3xl font-normal tracking-tight md:text-4xl">
    {count === 0 ? (
      <Fragment>Arsa <em class="font-serif italic font-normal">karşılaştırma</em></Fragment>
    ) : (
      <Fragment>{count} arsayı <em class="font-serif italic font-normal">yan yana</em></Fragment>
    )}
  </h1>
  {hasInvalidIds && (
    <p class="mt-3 inline-flex items-center gap-2 rounded-xl border border-amber-500/40 bg-amber-500/10 px-3 py-1.5 text-[12.5px] text-amber-700 dark:text-amber-300">
      Bazı ID'ler bulunamadı; geçerli olanlar gösteriliyor.
    </p>
  )}
</header>
