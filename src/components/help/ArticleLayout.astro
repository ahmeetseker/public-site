---
import RootLayout from '@/layouts/RootLayout.astro'
import Breadcrumb from '@/components/help/Breadcrumb.astro'
import { findArticle } from '@/lib/help-index'
import { t, LOCALE_BCP47, detectLocaleFromPath } from '@/i18n'
import { articleSchema, faqPageSchema, toJsonLd, type FaqItem } from '@/lib/schema-builders'

export interface Props {
  /** slug must exist in help-index.ts */
  slug: string
  /** ISO date — used by JSON-LD dateModified */
  dateModified: string
  /**
   * F27.C — Optional FAQ items. When provided, an additional FAQPage JSON-LD
   * block is emitted alongside the Article schema. Pages that don't have a
   * question/answer structure simply omit this prop (graceful no-op).
   */
  faqs?: ReadonlyArray<FaqItem>
}

const { slug, dateModified, faqs } = Astro.props
const article = findArticle(slug)
if (!article) {
  throw new Error(`ArticleLayout: unknown slug "${slug}" — add it to help-index.ts first.`)
}

const locale = detectLocaleFromPath(Astro.url.pathname)
const prefix = locale === 'en' ? '/en' : ''
const isEn = locale === 'en'
// EN serves article.titleEn / summaryEn / bodyEn (body via <slot /> on the
// /en/yardim/<slug>.astro page). TR keeps inline slot HTML for stylistic
// flexibility — see /yardim/<slug>.astro pages.
const canonical = `https://arsam.net${prefix}${article.path}`
const headline = isEn ? article.titleEn : article.title
const description = isEn ? article.summaryEn : article.summary

const kickerLabel = isEn ? 'HELP ARTICLE' : 'YARDIM MAKALESİ'
const feedbackKicker = isEn ? 'FEEDBACK' : 'GERİ BİLDİRİM'
const feedbackHeading = isEn ? 'Was this article helpful?' : 'Bu makale yardımcı oldu mu?'
const feedbackNote = isEn
  ? 'Your answer is collected anonymously; no personal data is sent.'
  : 'Cevabınız anonim toplanır; herhangi bir kişisel veri gönderilmez.'
const feedbackYes = isEn ? 'Yes, it helped' : 'Evet, yardımcı oldu'
const feedbackNo = isEn ? "No, it's missing something" : 'Hayır, eksik kaldı'
const feedbackCta = isEn
  ? 'For more help, return to the <a class="underline underline-offset-2" href="/en/yardim">help centre</a> or <a class="underline underline-offset-2" href="/en/iletisim">contact us</a>.'
  : 'Daha fazla yardım için <a class="underline underline-offset-2" href="/yardim">yardım merkezine</a> dön veya <a class="underline underline-offset-2" href="/iletisim">bize yaz</a>.'

// F22.A — Article JSON-LD via F22.0 builder; we keep the publisher +
// inLanguage extras locally so the generic helper stays minimal.
const articleJsonLd: Record<string, unknown> = {
  ...(articleSchema({
    headline,
    description,
    url: canonical,
    dateModified,
    author: 'arsam.net',
  }) as Record<string, unknown>),
  inLanguage: LOCALE_BCP47[locale],
  publisher: { '@type': 'Organization', name: 'arsam.net' },
}
---
<RootLayout title={isEn ? `${headline} — Help · arsam.net` : `${headline} — Yardım · arsam.net`} description={description}>
  <link rel="canonical" href={canonical} slot="head" />
  <script is:inline type="application/ld+json" set:html={toJsonLd(articleJsonLd)} slot="head" />
  {faqs && faqs.length > 0 && (
    <script is:inline type="application/ld+json" set:html={toJsonLd(faqPageSchema(faqs))} slot="head" />
  )}

  <article class="mx-auto max-w-[920px] px-4 py-10 lg:py-14">
    <Breadcrumb
      items={[
        { label: t('search.breadcrumbHome', locale), href: `${prefix}/` },
        { label: t('helpPage.heading', locale), href: `${prefix}/yardim` },
        { label: headline },
      ]}
    />

    <header class="mb-8 max-w-[60ch]">
      <div class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">{kickerLabel}</div>
      <h1 class="font-serif text-3xl font-normal tracking-tight md:text-4xl">{headline}</h1>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{description}</p>
    </header>

    <div class="prose prose-neutral max-w-[68ch] text-foreground/85 [&_h2]:font-serif [&_h2]:text-xl [&_h2]:font-medium [&_h2]:tracking-tight [&_h2]:mt-8 [&_h2]:mb-3 [&_h3]:font-medium [&_h3]:mt-6 [&_h3]:mb-2 [&_p]:text-sm [&_p]:leading-relaxed [&_p]:mt-3 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:text-sm [&_ul]:text-muted-foreground [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:text-sm [&_ol]:text-muted-foreground [&_li]:mt-1.5 [&_a]:underline [&_a]:underline-offset-2 [&_strong]:text-foreground [&_code]:bg-card [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:text-xs [&_code]:font-mono">
      <slot />
    </div>

    <div class="mt-12 rounded-2xl border border-border bg-card/40 p-5">
      <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">{feedbackKicker}</div>
      <div class="mt-2 font-serif text-lg font-medium">{feedbackHeading}</div>
      <p class="mt-1 text-sm text-muted-foreground">{feedbackNote}</p>
      <div class="mt-4 flex flex-wrap gap-2" data-testid="article-feedback">
        <button
          type="button"
          class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium transition hover:bg-accent"
          data-feedback="yes"
        >
          {feedbackYes}
        </button>
        <button
          type="button"
          class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium transition hover:bg-accent"
          data-feedback="no"
        >
          {feedbackNo}
        </button>
      </div>
      <p class="mt-4 text-xs text-muted-foreground" set:html={feedbackCta} />
    </div>
  </article>
</RootLayout>
