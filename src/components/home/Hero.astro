---
// Hero — full-width band with serif headline + search bar + quick chips.
// Search submits via plain GET form to /ara — no JS required for SSG.
import { t, useDict, detectLocaleFromPath, type Locale } from '@/i18n'

export interface Props {
  locale?: Locale
}

const locale: Locale = Astro.props.locale ?? detectLocaleFromPath(Astro.url.pathname)
const prefix = locale === 'en' ? '/en' : ''
const hero = useDict('homepage.hero', locale) as Record<string, string>
const headlineParts = hero.headline.split('{accent}')

const popularChips: { label: string; q: string }[] = [
  { label: 'Ayvalık', q: 'Ayvalık' },
  { label: 'Çeşme · Alaçatı', q: 'Alaçatı' },
  { label: 'Datça', q: 'Datça' },
  { label: 'Fethiye Hisarönü', q: 'Hisarönü' },
  { label: locale === 'en' ? 'Urla olive grove' : 'Urla zeytinliği', q: 'Urla zeytinlik' },
]

const types: { value: string; labelKey: string }[] = [
  { value: '', labelKey: 'typeAll' },
  { value: 'İmarlı', labelKey: 'typeBuildable' },
  { value: 'Tarla', labelKey: 'typeField' },
  { value: 'Zeytinlik', labelKey: 'typeOlive' },
  { value: 'Villa Arsası', labelKey: 'typeVilla' },
]
---

<section class="relative overflow-hidden border-b border-border bg-card/60">
  <!-- subtle gradient overlay -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-70"
    style="background: radial-gradient(ellipse at 30% 0%, hsl(var(--accent) / 0.18), transparent 55%), radial-gradient(ellipse at 80% 100%, hsl(var(--accent) / 0.12), transparent 60%);"
  >
  </div>

  <div class="mx-auto max-w-[1280px] px-4 pt-14 pb-16 md:pt-20 md:pb-24">
    <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
      {hero.eyebrow}
    </div>
    <h1 class="mt-3 max-w-[20ch] font-serif text-4xl font-normal leading-[1.05] tracking-tight md:text-5xl lg:text-6xl">
      {headlineParts.map((part, i) => (
        <>
          {i > 0 && <em class="font-serif italic font-normal">{hero.headlineAccent}</em>}
          {part}
        </>
      ))}
    </h1>
    <p class="mt-4 max-w-[58ch] text-base text-muted-foreground md:text-lg">
      {hero.subhead}
    </p>

    <!-- Big search bar -->
    <form
      action={`${prefix}/ara`}
      method="GET"
      class="mt-8 flex w-full max-w-[820px] flex-col gap-2 rounded-2xl border border-border bg-background p-2 shadow-sm md:flex-row md:items-center md:gap-1 md:p-1.5"
      role="search"
      aria-label={hero.searchAriaLabel}
    >
      <label class="flex flex-1 items-center gap-2 px-3 md:px-3">
        <span class="sr-only">{hero.locationLabel}</span>
        <svg
          class="h-4 w-4 shrink-0 text-muted-foreground"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          type="search"
          name="q"
          placeholder={hero.searchPlaceholder}
          class="w-full bg-transparent py-3 text-[15px] text-foreground outline-none placeholder:text-muted-foreground md:py-2.5"
          autocomplete="off"
        />
      </label>

      <label class="flex items-center gap-2 border-t border-border px-3 md:border-l md:border-t-0 md:px-3">
        <span class="sr-only">{hero.typeLabel}</span>
        <select
          name="tip"
          class="w-full appearance-none bg-transparent py-3 text-[14px] text-foreground outline-none md:py-2.5"
        >
          {types.map((ty) => <option value={ty.value}>{t(`homepage.hero.${ty.labelKey}`, locale)}</option>)}
        </select>
        <svg
          class="h-3.5 w-3.5 shrink-0 text-muted-foreground"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </label>

      <button
        type="submit"
        class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-accent px-5 py-3 text-[14px] font-medium text-accent-foreground transition-opacity hover:opacity-90 md:py-2.5"
      >
        {hero.searchSubmit}
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </button>
    </form>

    <!-- Quick chips -->
    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
        {hero.popularSearches}
      </span>
      {
        popularChips.map((chip) => (
          <a
            href={`${prefix}/ara?q=${encodeURIComponent(chip.q)}`}
            class="inline-flex items-center rounded-full border border-border bg-background px-3 py-1 text-xs text-muted-foreground transition hover:bg-accent hover:text-accent-foreground"
          >
            {chip.label}
          </a>
        ))
      }
    </div>
  </div>
</section>
