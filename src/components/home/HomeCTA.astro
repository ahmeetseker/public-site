---
// Bottom CTA band — invites listing owners to publish via a partner office.
import { useDict, t, detectLocaleFromPath, type Locale } from '@/i18n'

export interface Props {
  locale?: Locale
}

const locale: Locale = Astro.props.locale ?? detectLocaleFromPath(Astro.url.pathname)
const prefix = locale === 'en' ? '/en' : ''
const dict = useDict('homepage.cta', locale) as Record<string, string>
const headlineParts = dict.headline.split('{accent}')
const eyebrow = locale === 'en' ? 'FOR OFFICES' : 'OFİSLER İÇİN'
const seeOffices = locale === 'en' ? 'See offices' : 'Ofisleri gör'
const listLabel = locale === 'en' ? 'List a property' : 'İlan ver'
---

<section class="mx-auto max-w-[1280px] px-4 py-16 md:py-24">
  <div class="relative overflow-hidden rounded-3xl border border-border bg-accent px-6 py-12 text-accent-foreground md:px-12 md:py-16">
    <div
      class="pointer-events-none absolute inset-0 -z-0 opacity-30"
      style="background: radial-gradient(ellipse at 80% 20%, hsl(var(--background) / 0.6), transparent 55%);"
    >
    </div>
    <div class="relative z-10 flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between md:gap-10">
      <div class="max-w-[44ch]">
        <div class="font-mono text-xs uppercase tracking-[0.18em] opacity-70">
          {eyebrow}
        </div>
        <h2 class="mt-3 font-serif text-3xl font-normal leading-tight tracking-tight md:text-4xl">
          {headlineParts.map((part, i) => (
            <>
              {i > 0 && <em class="font-serif italic font-normal">{dict.headlineAccent}</em>}
              {part}
            </>
          ))}
        </h2>
        <p class="mt-3 text-sm opacity-80 md:text-base">
          {dict.subhead}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={`${prefix}/ilan-ver`}
          class="inline-flex items-center gap-1.5 rounded-xl bg-background px-5 py-3 text-sm font-medium text-foreground transition-opacity hover:opacity-90"
        >
          {listLabel}
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
        <a
          href={`${prefix}/ofisler`}
          class="inline-flex items-center rounded-xl border border-accent-foreground/30 px-5 py-3 text-sm font-medium transition hover:bg-accent-foreground/10"
        >
          {seeOffices}
        </a>
      </div>
    </div>
  </div>
</section>
