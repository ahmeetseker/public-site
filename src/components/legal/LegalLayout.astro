---
export interface Props {
  title: string
  lastUpdated: string
  sections: Array<{ id: string; title: string }>
}
const { title, lastUpdated, sections } = Astro.props
---
<article class="mx-auto max-w-[1200px] px-4 py-12 lg:py-16">
  <header class="mb-10">
    <div class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">YASAL · DOKÜMAN</div>
    <h1 class="font-serif text-4xl font-normal tracking-tight md:text-5xl">{title}</h1>
    <div class="mt-3 text-sm text-muted-foreground">Son güncelleme: {lastUpdated}</div>
  </header>

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-[240px_1fr]">
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <details class="group rounded-2xl border border-border bg-card p-4 lg:open:block" open>
        <summary class="cursor-pointer list-none font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground lg:cursor-default">İçindekiler</summary>
        <nav class="mt-3 flex flex-col gap-1.5 text-sm">
          {sections.map((s) => (
            <a href={`#${s.id}`} class="text-muted-foreground transition hover:text-foreground">{s.title}</a>
          ))}
        </nav>
      </details>
    </aside>

    <div class="prose-tr max-w-[68ch]">
      <slot />
    </div>
  </div>
</article>

<style is:global>
  .prose-tr h2 { font-family: ui-serif, "New York", Lora, serif; font-size: 1.5rem; font-weight: 400; line-height: 1.3; margin-top: 2.5rem; margin-bottom: 0.75rem; letter-spacing: -0.01em; scroll-margin-top: 6rem; }
  .prose-tr h3 { font-family: ui-serif, "New York", Lora, serif; font-size: 1.15rem; font-weight: 500; margin-top: 1.5rem; margin-bottom: 0.5rem; }
  .prose-tr p { color: hsl(var(--foreground) / 0.86); line-height: 1.72; margin-bottom: 1rem; font-size: 0.95rem; }
  .prose-tr ul { list-style: disc outside; padding-left: 1.4em; margin: 0.5rem 0 1rem; }
  .prose-tr ol { list-style: decimal outside; padding-left: 1.4em; margin: 0.5rem 0 1rem; }
  .prose-tr li { color: hsl(var(--foreground) / 0.86); line-height: 1.7; margin-bottom: 0.3rem; font-size: 0.95rem; }
  .prose-tr strong { color: hsl(var(--foreground)); font-weight: 600; }
  .prose-tr a { color: hsl(var(--foreground)); text-decoration: underline; text-decoration-color: hsl(var(--border)); text-underline-offset: 3px; }
  .prose-tr a:hover { text-decoration-color: hsl(var(--foreground)); }
  .prose-tr blockquote { border-left: 2px solid hsl(var(--border)); padding: 0.25rem 0 0.25rem 1rem; margin: 1.25rem 0; color: hsl(var(--muted-foreground)); font-size: 0.9rem; }
</style>
