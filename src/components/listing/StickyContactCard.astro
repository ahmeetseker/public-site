---
import type { Listing } from '@landx/data'
import { formatTLCompact } from '@landx/ui/lib'

export interface Props {
  listing: Listing
  sellerName?: string
  sellerRating?: number
  sellerListings?: number
}

const {
  listing,
  sellerName = 'Mert Soydan',
  sellerRating = 4.9,
  sellerListings = 142,
} = Astro.props

const unitPrice = Math.round(listing.price / listing.size)
const initials = sellerName
  .split(' ')
  .map((p) => p[0])
  .slice(0, 2)
  .join('')
  .toUpperCase()
---
<aside class="space-y-2">
  <!-- Ana fiyat / CTA kartı -->
  <div class="relative rounded-2xl border border-border bg-card p-4">
    <div class="absolute -top-2 right-3 inline-flex items-center gap-1 rounded-full bg-amber-100 px-2 py-0.5 text-[9px] font-medium tracking-wider text-amber-900">
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17v5"/><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"/></svg>
      YAPIŞKAN
    </div>

    <div class="font-serif text-2xl font-normal leading-tight tracking-tight tabular-nums">
      {formatTLCompact(listing.price)}
    </div>
    <div class="mt-1 text-[11px] text-muted-foreground">
      ₺ {unitPrice.toLocaleString('tr-TR')} / m² ·
      <span class="font-medium text-emerald-700">%9 emsal altı</span>
    </div>

    <div class="mt-3 flex items-center gap-1.5 rounded-md bg-emerald-50 px-2 py-1.5">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-emerald-700" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
      <span class="text-[10px] font-medium leading-tight text-emerald-900">14 katmanlı veri doğrulamalı</span>
    </div>

    <button
      type="button"
      data-toast="Teklif formu açılıyor..."
      data-toast-kind="success"
      class="mt-3 flex w-full items-center justify-center rounded-md bg-foreground px-3 py-2.5 text-sm font-medium text-background transition hover:opacity-90"
    >
      Teklif ver
    </button>
    <button
      type="button"
      data-toast="Mesaj kutusu açılıyor..."
      data-toast-kind="success"
      class="mt-1.5 flex w-full items-center justify-center gap-1.5 rounded-md border border-border bg-transparent px-3 py-2.5 text-sm font-medium transition hover:bg-muted"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Mesaj at
    </button>

    <!-- Satıcı özeti -->
    <div class="mt-3 flex items-center gap-2 border-t border-border pt-3">
      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-amber-100 text-[11px] font-medium text-amber-900">
        {initials}
      </div>
      <div class="min-w-0 flex-1">
        <div class="truncate text-[11px] font-medium leading-tight">{sellerName}</div>
        <div class="mt-0.5 flex items-center gap-1 text-[10px] text-muted-foreground">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" class="text-amber-500" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          {sellerRating} · {sellerListings} ilan
        </div>
      </div>
      <a
        href="tel:+905320000000"
        aria-label="Satıcıyı ara"
        class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 transition hover:bg-emerald-100"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </a>
    </div>
  </div>

  <!-- Fiyat alarmı mini panel -->
  <div class="rounded-2xl border border-border bg-card px-3.5 py-3">
    <div class="mb-1.5 flex items-center gap-1.5">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sky-700" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
      <span class="text-xs font-medium">Fiyat alarmı</span>
    </div>
    <p class="mb-2 text-[11px] leading-relaxed text-muted-foreground">
      Fiyat düştüğünde e-posta ve push bildirim al.
    </p>
    <div class="flex gap-1">
      <button type="button" data-alarm="3" class="rounded-full border border-border bg-transparent px-2.5 py-1 text-[11px] font-medium transition hover:bg-muted">%3</button>
      <button type="button" data-alarm="5" class="rounded-full bg-foreground px-2.5 py-1 text-[11px] font-medium text-background">%5</button>
      <button type="button" data-alarm="10" class="rounded-full border border-border bg-transparent px-2.5 py-1 text-[11px] font-medium transition hover:bg-muted">%10</button>
    </div>
  </div>
</aside>
