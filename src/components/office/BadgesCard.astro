---
import type { Office } from '@landx/data'

export interface Props {
  office: Office
}

const { office } = Astro.props
const years = new Date().getFullYear() - office.founded

const badges: { label: string; sub?: string }[] = [
  { label: 'Doğrulanmış üye', sub: 'arsam.net ekibi kimlik doğruladı' },
  { label: `${years} yıllık deneyim`, sub: `Kuruluş ${office.founded}` },
  { label: 'KVKK uyumlu', sub: 'Aydınlatma + onay süreci' },
]
---

<aside
  aria-labelledby="ofis-rozetler"
  class="rounded-2xl border border-border bg-card p-5 md:p-6"
>
  <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
    GÜVEN GÖSTERGELERİ
  </div>
  <h2 id="ofis-rozetler" class="mt-1 font-serif text-xl font-normal tracking-tight md:text-2xl">
    Rozetler
  </h2>

  <ul class="mt-4 space-y-2">
    {badges.map((b) => (
      <li class="flex items-start gap-2.5 rounded-xl border border-border bg-background p-3">
        <span
          class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-accent text-accent-foreground"
          aria-hidden="true"
        >
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 6 9 17l-5-5" />
          </svg>
        </span>
        <div class="min-w-0">
          <div class="font-serif text-sm font-medium tracking-tight">{b.label}</div>
          {b.sub && <div class="text-xs text-muted-foreground">{b.sub}</div>}
        </div>
      </li>
    ))}
  </ul>

  <div class="mt-5">
    <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
      Uzmanlık
    </div>
    <div class="mt-2 flex flex-wrap gap-1.5">
      {office.specialties.map((s) => (
        <span class="inline-flex items-center rounded-full border border-border bg-background px-2.5 py-1 text-xs text-foreground">
          {s}
        </span>
      ))}
    </div>
  </div>
</aside>
