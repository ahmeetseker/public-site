---
import type { Office } from '@landx/data'

export interface Props {
  office: Office
}

const { office } = Astro.props

const yearsActive = new Date().getFullYear() - office.founded

const stats: { eyebrow: string; value: string; unit?: string }[] = [
  { eyebrow: 'Faaliyet', value: String(yearsActive), unit: 'yıl' },
  { eyebrow: 'Satış uzmanı', value: String(office.agentCount) },
  { eyebrow: 'Aktif ilan', value: String(office.listingCount) },
  { eyebrow: 'Memnuniyet', value: office.rating.toFixed(1), unit: '/5' },
]
---

<section aria-labelledby="ofis-hakkinda" class="rounded-2xl border border-border bg-card p-5 md:p-6">
  <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
    OFİS HAKKINDA
  </div>
  <h2 id="ofis-hakkinda" class="mt-1 font-serif text-2xl font-normal tracking-tight md:text-3xl">
    {office.name}
  </h2>

  <p class="mt-3 max-w-[68ch] text-[15px] leading-relaxed text-foreground/85">
    {office.description}
  </p>

  <dl class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-4">
    {stats.map((s) => (
      <div class="rounded-xl border border-border bg-background p-3">
        <dt class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
          {s.eyebrow}
        </dt>
        <dd class="mt-1 font-serif text-2xl font-normal tracking-tight tabular-nums">
          {s.value}{s.unit && <span class="ml-0.5 text-sm text-muted-foreground">{s.unit}</span>}
        </dd>
      </div>
    ))}
  </dl>

  <div class="mt-5">
    <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
      Uzmanlık alanları
    </div>
    <div class="mt-2 flex flex-wrap gap-1.5">
      {office.specialties.map((s) => (
        <span class="inline-flex items-center rounded-full border border-border bg-background px-2.5 py-1 text-xs text-foreground">
          {s}
        </span>
      ))}
    </div>
  </div>
</section>
