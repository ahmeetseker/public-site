---
import type { OfficeReview } from '@landx/data'

export interface Props {
  reviews: OfficeReview[]
}

const { reviews } = Astro.props

function initials(name: string): string {
  return name
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0]?.toLocaleUpperCase('tr-TR') ?? '')
    .join('')
}
---

<section aria-labelledby="ofis-degerlendirmeler" class="rounded-2xl border border-border bg-card p-5 md:p-6">
  <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
    DEĞERLENDİRMELER
  </div>
  <h2 id="ofis-degerlendirmeler" class="mt-1 font-serif text-2xl font-normal tracking-tight md:text-3xl">
    Müşteri <em class="italic">yorumları</em>
  </h2>

  {reviews.length === 0 ? (
    <p class="mt-4 text-sm text-muted-foreground">Henüz yorum yok.</p>
  ) : (
    <ul class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-2">
      {reviews.map((r) => (
        <li class="rounded-xl border border-border bg-background p-4">
          <div class="flex items-center gap-3">
            <div
              class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-accent font-mono text-xs font-medium text-accent-foreground"
              aria-hidden="true"
            >
              {initials(r.name)}
            </div>
            <div class="min-w-0 flex-1">
              <div class="truncate font-serif text-sm font-medium tracking-tight">{r.name}</div>
              <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
                {r.date}
              </div>
            </div>
            <div
              class="flex items-center gap-0.5"
              aria-label={`${r.rating} / 5 yıldız`}
            >
              {Array.from({ length: 5 }).map((_, i) => (
                <svg
                  class={i < r.rating ? 'h-3.5 w-3.5 text-foreground' : 'h-3.5 w-3.5 text-muted-foreground/30'}
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12 2 14.9 8.6 22 9.3l-5.3 4.8 1.6 7-6.3-3.6L5.7 21l1.6-7L2 9.3l7.1-.7L12 2Z" />
                </svg>
              ))}
            </div>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-foreground/85">
            {r.text}
          </p>
        </li>
      ))}
    </ul>
  )}
</section>
