---
// Wave-5 / Agent-25 / Faz 9.11 — FAQ accordion for /ofisler index page.
const faqs = [
  {
    q: 'arsam.net ofisleri nasıl doğruluyor?',
    a: 'Her ofis için vergi levhası, faaliyet adresi, en az iki referans satış ve KVKK uyumlu müşteri iletişim sözleşmesi şart koşulur. Doğrulama yılda bir kez yenilenir; eksiklik halinde rozet askıya alınır.',
  },
  {
    q: 'Ofislerle aracısız mı iletişim kurabilirim?',
    a: 'Evet. Aramaları, mesajları ve toplantıları doğrudan ofisin satış uzmanıyla yaparsınız. arsam.net işlem üzerinden komisyon kesmez — yalnızca üyelik / ilan ücreti alır.',
  },
  {
    q: 'Verdiğim bilgiler KVKK kapsamında güvende mi?',
    a: 'İletişim bilgileriniz yalnızca seçtiğiniz ofise iletilir; üçüncü taraflarla paylaşılmaz. Veri silme talebinizi her zaman /kvkk sayfasındaki formdan iletebilirsiniz.',
  },
  {
    q: 'Ofise gitmeden tapuya gidebilir miyim?',
    a: "Çoğu ofis remote keşif (drone video, parselasyon krokisi, tapuya kadar dijital evrak akışı) sunar. Detaylar ofis profili sayfasındaki 'Hizmet seti' bölümünde listelenir.",
  },
]
---

<section class="mx-auto max-w-[1280px] px-4 py-16 md:py-20">
  <div class="mb-8">
    <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
      SIKÇA SORULANLAR
    </div>
    <h2 class="mt-2 font-serif text-3xl font-normal tracking-tight md:text-4xl">
      Ofisler <em class="font-serif italic font-normal">hakkında</em>
    </h2>
  </div>

  <div class="max-w-[68ch] space-y-3">
    {
      faqs.map((f, i) => (
        <details
          class="group rounded-xl border border-border bg-card transition open:bg-card open:shadow-sm"
          open={i === 0}
        >
          <summary class="flex cursor-pointer items-start justify-between gap-4 p-5 text-left">
            <span class="font-serif text-base font-medium tracking-tight md:text-lg">{f.q}</span>
            <svg
              class="mt-1 h-4 w-4 flex-none text-muted-foreground transition group-open:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <div class="px-5 pb-5 text-sm leading-relaxed text-muted-foreground md:text-[15px]">
            {f.a}
          </div>
        </details>
      ))
    }
  </div>
</section>
