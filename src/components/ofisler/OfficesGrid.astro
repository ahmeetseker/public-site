---
// Wave-5 / Agent-25 / Faz 9.11 — Office card grid (pure Astro, no island).
import type { Office } from '@landx/data'

export interface Props {
  offices: Office[]
}

const { offices } = Astro.props
---

{
  offices.length === 0 ? (
    <section class="mx-auto max-w-[1280px] px-4 py-16 md:py-20">
      <div class="rounded-xl border border-border bg-card p-10 text-center">
        <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
          SONUÇ YOK
        </div>
        <h2 class="mt-2 font-serif text-2xl font-normal tracking-tight">
          Bu filtreyle eşleşen ofis bulunmadı
        </h2>
        <p class="mt-3 text-sm text-muted-foreground">
          Filtreyi temizleyerek tüm ofisleri görebilirsiniz.
        </p>
        <a
          href="/ofisler"
          class="mt-5 inline-flex h-10 items-center rounded-full bg-foreground px-5 text-sm text-background transition hover:bg-foreground/90"
        >
          Tüm ofisleri göster
        </a>
      </div>
    </section>
  ) : (
    <section class="mx-auto max-w-[1280px] px-4 py-10 md:py-14">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
        {offices.map((o) => {
          const fullStars = Math.floor(o.rating)
          const hasHalf = o.rating - fullStars >= 0.5
          const emptyStars = 5 - fullStars - (hasHalf ? 1 : 0)
          return (
            <a
              href={`/ofis/${o.slug}`}
              class="group flex flex-col gap-4 rounded-xl border border-border bg-card p-5 transition hover:border-foreground/30 hover:bg-card md:p-6"
            >
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
                    EMLAK OFİSİ · {o.district.toUpperCase()}
                  </div>
                  <h2 class="mt-1 font-serif text-2xl font-normal tracking-tight md:text-3xl">
                    {o.name}
                  </h2>
                  <p class="mt-1 text-xs text-muted-foreground md:text-sm">
                    {o.district}, {o.city} · kuruluş{' '}
                    <span class="font-mono tabular-nums">{o.founded}</span>
                  </p>
                </div>
                <span
                  class="inline-flex flex-none items-center gap-1.5 rounded-full border border-border bg-accent/40 px-2 py-0.5 text-xs font-medium text-accent-foreground"
                  aria-label="Doğrulanmış üye"
                >
                  <svg
                    class="h-2.5 w-2.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  Doğrulanmış
                </span>
              </div>

              <p class="line-clamp-2 text-sm leading-relaxed text-muted-foreground">
                {o.description}
              </p>

              <div class="flex flex-wrap items-center gap-3 border-t border-border pt-4">
                <div class="flex items-center gap-0.5" aria-hidden="true">
                  {Array.from({ length: fullStars }).map(() => (
                    <svg class="h-3.5 w-3.5 text-foreground" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2 14.9 8.6 22 9.3l-5.3 4.8 1.6 7-6.3-3.6L5.7 21l1.6-7L2 9.3l7.1-.7L12 2Z" />
                    </svg>
                  ))}
                  {hasHalf && (
                    <svg class="h-3.5 w-3.5 text-foreground" viewBox="0 0 24 24">
                      <defs>
                        <linearGradient id={`hs-${o.id}`}>
                          <stop offset="50%" stop-color="currentColor" />
                          <stop offset="50%" stop-color="transparent" />
                        </linearGradient>
                      </defs>
                      <path
                        d="M12 2 14.9 8.6 22 9.3l-5.3 4.8 1.6 7-6.3-3.6L5.7 21l1.6-7L2 9.3l7.1-.7L12 2Z"
                        fill={`url(#hs-${o.id})`}
                        stroke="currentColor"
                        stroke-width="1"
                      />
                    </svg>
                  )}
                  {Array.from({ length: emptyStars }).map(() => (
                    <svg
                      class="h-3.5 w-3.5 text-muted-foreground/40"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <path d="M12 2 14.9 8.6 22 9.3l-5.3 4.8 1.6 7-6.3-3.6L5.7 21l1.6-7L2 9.3l7.1-.7L12 2Z" />
                    </svg>
                  ))}
                </div>
                <span class="font-serif text-sm text-foreground">
                  {o.rating.toFixed(1)}
                  <span class="text-muted-foreground">/5</span>
                </span>
                <span class="font-mono text-xs tabular-nums text-muted-foreground">
                  {o.reviewCount} değerlendirme
                </span>
                <span class="font-mono text-xs tabular-nums text-muted-foreground">
                  · {o.listingCount} aktif ilan
                </span>
              </div>

              <div class="mt-1 flex items-center justify-between">
                <div class="flex flex-wrap gap-1.5">
                  {o.specialties.slice(0, 3).map((s) => (
                    <span class="rounded-full border border-border bg-background px-2 py-0.5 text-xs text-muted-foreground">
                      {s}
                    </span>
                  ))}
                </div>
                <span class="inline-flex items-center gap-1 font-mono text-xs uppercase tracking-[0.14em] text-foreground transition group-hover:gap-1.5">
                  Profili gör
                  <svg
                    class="h-3 w-3 transition group-hover:translate-x-0.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </svg>
                </span>
              </div>
            </a>
          )
        })}
      </div>
    </section>
  )
}
