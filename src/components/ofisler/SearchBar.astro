---
// Wave-5 / Agent-25 / Faz 9.11 — Ofisler list filter (il + free-text search).
// Filter applied server-side via URL query params (?il=Muğla&q=...).
export interface Props {
  cities: string[]
  activeIl: string
  q: string
  resultCount: number
}

const { cities, activeIl, q, resultCount } = Astro.props
const tabs = ['Tümü', ...cities]
---

<section class="border-b border-border bg-background">
  <div class="mx-auto max-w-[1280px] px-4 pb-6 pt-6">
    <form
      method="get"
      action="/ofisler"
      class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
    >
      <div
        class="flex flex-wrap items-center gap-1.5 rounded-full border border-border bg-card p-1"
        role="tablist"
        aria-label="İl filtresi"
      >
        {
          tabs.map((il) => {
            const isActive = il === activeIl
            const params = new URLSearchParams()
            if (il !== 'Tümü') params.set('il', il)
            if (q) params.set('q', q)
            const qs = params.toString()
            const href = qs ? `/ofisler?${qs}` : '/ofisler'
            return (
              <a
                href={href}
                role="tab"
                aria-selected={isActive}
                class:list={[
                  'rounded-full px-3 py-1.5 text-xs font-medium transition',
                  isActive
                    ? 'bg-foreground text-background'
                    : 'text-muted-foreground hover:bg-accent/40 hover:text-foreground',
                ]}
              >
                {il}
              </a>
            )
          })
        }
      </div>

      <label class="relative flex w-full items-center md:max-w-xs">
        <svg
          class="absolute left-3 h-4 w-4 text-muted-foreground"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <span class="sr-only">Ofis adı veya bölge ara</span>
        <input
          type="search"
          name="q"
          value={q}
          aria-label="Ofis adı veya bölge ara"
          placeholder="Ofis adı veya bölge ara…"
          class="h-10 w-full rounded-full border border-border bg-card pl-9 pr-3 text-sm text-foreground placeholder:text-muted-foreground focus:border-foreground focus:outline-none"
        />
        {
          activeIl !== 'Tümü' && (
            <input type="hidden" name="il" value={activeIl} />
          )
        }
      </label>
    </form>

    <div class="mt-3 font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground">
      <span class="tabular-nums">{resultCount}</span> ofis listeleniyor
    </div>
  </div>
</section>
