---
/**
 * F37 Faz 4.0 — Arsa-özgü filtre bloğu.
 */
---
<fieldset class="space-y-3 border-t border-border pt-4">
  <legend class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Arsa Filtreleri</legend>

  <div>
    <label class="text-xs text-foreground">İmar durumu</label>
    <select name="imar" class="mt-1 w-full rounded-md border border-border bg-background px-2 py-1.5 text-sm">
      <option value="">Tümü</option>
      <option value="konut">Konut</option>
      <option value="ticari">Ticari</option>
      <option value="tarim">Tarım</option>
      <option value="sanayi">Sanayi</option>
      <option value="turizm">Turizm</option>
    </select>
  </div>

  <div>
    <label class="text-xs text-foreground">KAKS aralığı</label>
    <div class="mt-1 flex gap-2">
      <input type="number" name="kaks-min" min="0" max="3" step="0.1" placeholder="Min" class="w-1/2 rounded-md border border-border bg-background px-2 py-1.5 text-sm" />
      <input type="number" name="kaks-max" min="0" max="3" step="0.1" placeholder="Max" class="w-1/2 rounded-md border border-border bg-background px-2 py-1.5 text-sm" />
    </div>
  </div>

  <div>
    <label class="text-xs text-foreground">Tapu durumu</label>
    <select name="tapu" class="mt-1 w-full rounded-md border border-border bg-background px-2 py-1.5 text-sm">
      <option value="">Tümü</option>
      <option value="tapulu">Tapulu</option>
      <option value="hisseli">Hisseli</option>
      <option value="kat-irtifaki">Kat irtifakı</option>
      <option value="kat-mulkiyeti">Kat mülkiyeti</option>
    </select>
  </div>

  <div class="space-y-1.5">
    <label class="flex items-center gap-2 text-xs">
      <input type="checkbox" name="yola-cephe" /> Yola cephe
    </label>
    <label class="flex items-center gap-2 text-xs">
      <input type="checkbox" name="su" /> Su
    </label>
    <label class="flex items-center gap-2 text-xs">
      <input type="checkbox" name="elektrik" /> Elektrik
    </label>
  </div>

  <div>
    <label class="text-xs text-foreground">Deprem risk bandı</label>
    <div class="mt-1 flex gap-1.5">
      <label class="inline-flex items-center gap-1 rounded-full border border-border px-2 py-1 text-xs">
        <input type="checkbox" name="depremRisk" value="dusuk" /> Düşük
      </label>
      <label class="inline-flex items-center gap-1 rounded-full border border-border px-2 py-1 text-xs">
        <input type="checkbox" name="depremRisk" value="orta" /> Orta
      </label>
      <label class="inline-flex items-center gap-1 rounded-full border border-border px-2 py-1 text-xs">
        <input type="checkbox" name="depremRisk" value="yuksek" /> Yüksek
      </label>
    </div>
  </div>
</fieldset>
