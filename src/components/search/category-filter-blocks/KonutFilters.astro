---
/**
 * F37 Faz 4.0 — Konut-özgü filtre bloğu.
 */
---
<fieldset class="space-y-3 border-t border-border pt-4">
  <legend class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Konut Filtreleri</legend>

  <div>
    <label class="text-xs text-foreground">Oda sayısı</label>
    <div class="mt-1 flex flex-wrap gap-1">
      {['1+0', '1+1', '2+1', '3+1', '4+1', '5+1', '6+'].map((r) => (
        <label class="inline-flex items-center gap-1 rounded-full border border-border px-2 py-1 text-xs">
          <input type="checkbox" name="odalar" value={r} /> {r}
        </label>
      ))}
    </div>
  </div>

  <div>
    <label class="text-xs text-foreground">Bina yaşı (yıl)</label>
    <div class="mt-1 flex gap-2">
      <input type="number" name="binaYasi-min" placeholder="Min" class="w-1/2 rounded-md border border-border bg-background px-2 py-1.5 text-sm" />
      <input type="number" name="binaYasi-max" placeholder="Max" class="w-1/2 rounded-md border border-border bg-background px-2 py-1.5 text-sm" />
    </div>
  </div>

  <div>
    <label class="text-xs text-foreground">Bulunduğu kat</label>
    <div class="mt-1 flex flex-wrap gap-1">
      {['bodrum', 'zemin', '1', '2-5', '5-10', '10+'].map((k) => (
        <label class="inline-flex items-center gap-1 rounded-full border border-border px-2 py-1 text-xs">
          <input type="checkbox" name="kat-floor" value={k} /> {k}
        </label>
      ))}
    </div>
  </div>

  <div>
    <label class="text-xs text-foreground">Isıtma</label>
    <div class="mt-1 flex flex-wrap gap-1">
      {['dogalgaz-kombi', 'dogalgaz-merkezi', 'klima', 'yerden'].map((h) => (
        <label class="inline-flex items-center gap-1 rounded-full border border-border px-2 py-1 text-xs">
          <input type="checkbox" name="isitma" value={h} /> {h.replace('-', ' ')}
        </label>
      ))}
    </div>
  </div>

  <div class="space-y-1.5">
    <label class="flex items-center gap-2 text-xs">
      <input type="checkbox" name="asansor" /> Asansörlü
    </label>
    <label class="flex items-center gap-2 text-xs">
      <input type="checkbox" name="site-ici" /> Site içinde
    </label>
    <label class="flex items-center gap-2 text-xs">
      <input type="checkbox" name="kredi" /> Krediye uygun
    </label>
    <label class="flex items-center gap-2 text-xs">
      <input type="checkbox" name="takas" /> Takasa uygun
    </label>
  </div>

  <div>
    <label class="text-xs text-foreground">Manzara</label>
    <div class="mt-1 flex flex-wrap gap-1">
      {['deniz', 'goller', 'orman', 'dag', 'sehir', 'park'].map((m) => (
        <label class="inline-flex items-center gap-1 rounded-full border border-border px-2 py-1 text-xs">
          <input type="checkbox" name="view" value={m} /> {m}
        </label>
      ))}
    </div>
  </div>

  <div>
    <label class="text-xs text-foreground">Enerji sınıfı</label>
    <div class="mt-1 flex gap-1.5">
      {['A', 'B', 'C', 'D', 'E', 'F'].map((e) => (
        <label class="inline-flex items-center gap-1 rounded-full border border-border px-2 py-1 text-xs">
          <input type="checkbox" name="energy" value={e} /> {e}
        </label>
      ))}
    </div>
  </div>
</fieldset>
