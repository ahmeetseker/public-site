---
/**
 * F37 Faz 4.0 — Villa-özgü filtre bloğu.
 */
---
<fieldset class="space-y-3 border-t border-border pt-4">
  <legend class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Villa Filtreleri</legend>

  <div>
    <label class="text-xs text-foreground">Oda sayısı</label>
    <div class="mt-1 flex flex-wrap gap-1">
      {['3+1', '4+1', '5+1', '5+2', '6+'].map((r) => (
        <label class="inline-flex items-center gap-1 rounded-full border border-border px-2 py-1 text-xs">
          <input type="checkbox" name="odalar" value={r} /> {r}
        </label>
      ))}
    </div>
  </div>

  <div>
    <label class="text-xs text-foreground">Yapı tipi</label>
    <div class="mt-1 flex flex-wrap gap-1">
      {['villa', 'dubleks', 'tripleks', 'kosk'].map((t) => (
        <label class="inline-flex items-center gap-1 rounded-full border border-border px-2 py-1 text-xs">
          <input type="checkbox" name="subType" value={t} /> {t}
        </label>
      ))}
    </div>
  </div>

  <div class="space-y-1.5">
    <label class="flex items-center gap-2 text-xs">
      <input type="checkbox" name="amenity" value="havuz" /> Havuzlu
    </label>
    <label class="flex items-center gap-2 text-xs">
      <input type="checkbox" name="amenity" value="yesil-alan" /> Bahçeli
    </label>
    <label class="flex items-center gap-2 text-xs">
      <input type="checkbox" name="amenity" value="guvenlik" /> Güvenlikli
    </label>
    <label class="flex items-center gap-2 text-xs">
      <input type="checkbox" name="kredi" /> Krediye uygun
    </label>
    <label class="flex items-center gap-2 text-xs">
      <input type="checkbox" name="takas" /> Takasa uygun
    </label>
  </div>

  <div>
    <label class="text-xs text-foreground">Bina yaşı (yıl)</label>
    <div class="mt-1 flex gap-2">
      <input type="number" name="binaYasi-min" placeholder="Min" class="w-1/2 rounded-md border border-border bg-background px-2 py-1.5 text-sm" />
      <input type="number" name="binaYasi-max" placeholder="Max" class="w-1/2 rounded-md border border-border bg-background px-2 py-1.5 text-sm" />
    </div>
  </div>
</fieldset>
