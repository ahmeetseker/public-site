---
export interface FaqItem {
  q: string
  a: string
}
export interface Props {
  id: string
  title: string
  items: FaqItem[]
}
const { id, title, items } = Astro.props
---
<section id={id} aria-labelledby={`${id}-title`} class="mb-12">
  <h2 id={`${id}-title`} class="font-serif text-2xl font-normal tracking-tight mt-10 mb-3">{title}</h2>
  <div class="flex flex-col gap-2">
    {items.map((item) => (
      <details class="group rounded-xl border border-border bg-card/40 p-4 transition open:bg-card/70">
        <summary class="flex cursor-pointer items-start justify-between gap-4 list-none">
          <span class="text-sm font-medium text-foreground">{item.q}</span>
          <span class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground transition group-open:rotate-180">▾</span>
        </summary>
        <div class="mt-3 text-sm leading-relaxed text-muted-foreground" set:html={item.a} />
      </details>
    ))}
  </div>
</section>
