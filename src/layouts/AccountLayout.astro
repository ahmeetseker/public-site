---
// Shared layout for /hesabim/* (TR) and /en/hesabim/* (EN).
// Left sidebar with mini profile + nav, right slot for content.
// Mobile: sidebar stacks above content; nav becomes a horizontal scrollable pill bar.
//
// Wave F23.B — locale-aware sidebar:
//   * EN routes mirror TR slugs under /en/hesabim/* (convention; not /en/account/*).
//   * Labels swap TR↔EN based on Astro.url.pathname.
//   * Aria-label on <aside> nav swaps too.
import { BUYER } from '@landx/data'
import { detectLocaleFromPath } from '@/i18n'

export type AccountSection = 'dashboard' | 'favori' | 'mesajlar' | 'aramalar' | 'profil' | 'published' | 'aboneliklerim' | 'ayarlar' | 'destek' | 'bildirimler' | 'teklifler' | 'randevular' | 'ai-gecmis' | 'odemeler' | 'islemler' | 'ai' | 'ai-tercihleri'

export interface Props {
  active: AccountSection
}

const { active } = Astro.props

const locale = detectLocaleFromPath(Astro.url.pathname)
const base = locale === 'en' ? '/en/hesabim' : '/hesabim'
const logoutHref = locale === 'en' ? '/en/cikis' : '/cikis'

type NavItem = { key: AccountSection; slug: string; label: string; desc: string }

const NAV_TR: NavItem[] = [
  { key: 'dashboard', slug: '/', label: 'Genel bakış', desc: 'Özet ve son hareketler' },
  { key: 'favori', slug: '/favori', label: 'Favorilerim', desc: 'Kaydettiğin ilanlar' },
  { key: 'published', slug: '/ilanlarim', label: 'İlanlarım', desc: 'Yayınladığın ilanlar' },
  { key: 'mesajlar', slug: '/mesajlar', label: 'Mesajlarım', desc: 'Ofislerle konuşmalar' },
  { key: 'teklifler', slug: '/teklifler', label: 'Tekliflerim', desc: 'Verdiğin/aldığın teklifler' },
  { key: 'randevular', slug: '/randevular', label: 'Görme randevuları', desc: 'Planlanan parsel ziyaretleri' },
  { key: 'bildirimler', slug: '/bildirimler', label: 'Bildirimler', desc: 'Sistem ve mesaj bildirimleri' },
  { key: 'aramalar', slug: '/aramalar', label: 'Kayıtlı aramalar', desc: 'Bildirim alıyorsun' },
  { key: 'ai-gecmis', slug: '/ai-gecmis', label: 'AI geçmişi', desc: 'AI ile sorgu ve öneri geçmişi' },
  { key: 'ai', slug: '/ai', label: 'AI asistan', desc: 'Sohbet, değerleme, tapu kontrolü' },
  { key: 'ai-tercihleri', slug: '/ai-tercihleri', label: 'AI tercihleri', desc: 'Akıllı bildirim ve quiet hours' },
  { key: 'aboneliklerim', slug: '/aboneliklerim', label: 'Aboneliklerim', desc: 'Plan ve faturalar' },
  { key: 'odemeler', slug: '/odemeler', label: 'Ödemelerim', desc: 'Ödeme geçmişi ve faturalar' },
  { key: 'islemler', slug: '/islemler', label: 'Kredi işlemleri', desc: 'Cüzdan/kredi hareketleri' },
  { key: 'ayarlar', slug: '/ayarlar', label: 'Ayarlar', desc: 'Bildirim, dil, gizlilik' },
  { key: 'destek', slug: '/destek', label: 'Destek', desc: 'Yardım talepleri' },
  { key: 'profil', slug: '/profil', label: 'Profil ayarları', desc: 'Hesap & güvenlik' },
]

const NAV_EN: NavItem[] = [
  { key: 'dashboard', slug: '/', label: 'Overview', desc: 'Summary & recent activity' },
  { key: 'favori', slug: '/favori', label: 'Favorites', desc: 'Saved listings' },
  { key: 'published', slug: '/ilanlarim', label: 'My listings', desc: 'Published listings' },
  { key: 'mesajlar', slug: '/mesajlar', label: 'Messages', desc: 'Conversations with offices' },
  { key: 'teklifler', slug: '/teklifler', label: 'Offers', desc: 'Offers you sent/received' },
  { key: 'randevular', slug: '/randevular', label: 'Viewings', desc: 'Scheduled parcel visits' },
  { key: 'bildirimler', slug: '/bildirimler', label: 'Notifications', desc: 'System & message alerts' },
  { key: 'aramalar', slug: '/aramalar', label: 'Saved searches', desc: 'Alerts enabled' },
  { key: 'ai-gecmis', slug: '/ai-gecmis', label: 'AI history', desc: 'AI queries and suggestions' },
  { key: 'ai', slug: '/ai', label: 'AI assistant', desc: 'Chat, valuation, tapu check' },
  { key: 'ai-tercihleri', slug: '/ai-tercihleri', label: 'AI preferences', desc: 'Smart timing & quiet hours' },
  { key: 'aboneliklerim', slug: '/aboneliklerim', label: 'Subscriptions', desc: 'Plans & invoices' },
  { key: 'odemeler', slug: '/odemeler', label: 'Payments', desc: 'Payment history & invoices' },
  { key: 'islemler', slug: '/islemler', label: 'Wallet activity', desc: 'Credit/wallet transactions' },
  { key: 'ayarlar', slug: '/ayarlar', label: 'Settings', desc: 'Notifications, language, privacy' },
  { key: 'destek', slug: '/destek', label: 'Support', desc: 'Help requests' },
  { key: 'profil', slug: '/profil', label: 'Profile settings', desc: 'Account & security' },
]

const NAV = (locale === 'en' ? NAV_EN : NAV_TR).map((n) => ({
  ...n,
  href: n.slug === '/' ? `${base}/` : `${base}${n.slug}`,
}))

const demoModeLabel = locale === 'en' ? 'Demo mode' : 'Demo modu'
const desktopNavAria = locale === 'en' ? 'Account sections' : 'Hesap bölümleri'
const mobileNavAria = locale === 'en' ? 'Account sections (mobile)' : 'Hesap bölümleri (mobil)'
const signOutLong = locale === 'en' ? 'Sign out' : 'Çıkış yap'
const signOutShort = locale === 'en' ? 'Sign out' : 'Çıkış'
---

<div class="mx-auto max-w-[1280px] px-4 py-8 md:py-12">
  <div class="grid gap-8 md:grid-cols-[260px_1fr] md:gap-10">
    <aside class="md:sticky md:top-20 md:self-start">
      <!-- Mini profile -->
      <div class="rounded-2xl border border-border bg-card p-4">
        <div class="flex items-center gap-3">
          <div
            class="flex h-11 w-11 items-center justify-center rounded-full bg-foreground/10 font-serif text-base font-medium tracking-tight"
            aria-hidden="true"
          >
            {BUYER.avatarInitials}
          </div>
          <div class="min-w-0 flex-1">
            <div class="truncate text-sm font-medium">{BUYER.name}</div>
            <div class="truncate text-xs text-muted-foreground">{BUYER.email}</div>
          </div>
        </div>
        <div class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-amber-700 dark:bg-amber-400/10 dark:text-amber-300">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-500 dark:bg-amber-400"></span>
          {demoModeLabel}
        </div>
      </div>

      <!-- Desktop nav -->
      <nav class="mt-4 hidden flex-col gap-1 md:flex" aria-label={desktopNavAria}>
        {NAV.map((item) => {
          const isActive = item.key === active
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class={`group flex flex-col rounded-xl border px-3 py-2.5 transition ${
                isActive
                  ? 'border-foreground/15 bg-foreground/5'
                  : 'border-transparent hover:border-border hover:bg-foreground/5'
              }`}
            >
              <span class={`text-sm ${isActive ? 'font-medium text-foreground' : 'text-foreground'}`}>
                {item.label}
              </span>
              <span class="text-xs text-muted-foreground">{item.desc}</span>
            </a>
          )
        })}
        <a
          href={logoutHref}
          class="mt-2 flex items-center justify-between rounded-xl border border-transparent px-3 py-2.5 text-sm text-muted-foreground transition hover:border-border hover:bg-foreground/5 hover:text-foreground"
        >
          <span>{signOutLong}</span>
          <span aria-hidden="true">→</span>
        </a>
      </nav>

      <!-- Mobile nav (horizontal scroll) -->
      <nav class="mt-4 -mx-1 flex gap-2 overflow-x-auto px-1 [scrollbar-width:none] md:hidden [&::-webkit-scrollbar]:hidden" aria-label={mobileNavAria}>
        {NAV.map((item) => {
          const isActive = item.key === active
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class={`shrink-0 rounded-full border px-3 py-1.5 text-xs font-medium transition ${
                isActive
                  ? 'border-foreground/20 bg-foreground/10 text-foreground'
                  : 'border-border bg-card text-muted-foreground hover:text-foreground'
              }`}
            >
              {item.label}
            </a>
          )
        })}
        <a
          href={logoutHref}
          class="shrink-0 rounded-full border border-border bg-card px-3 py-1.5 text-xs font-medium text-muted-foreground transition hover:text-foreground"
        >
          {signOutShort}
        </a>
      </nav>
    </aside>

    <section class="min-w-0">
      <slot />
    </section>
  </div>
</div>
