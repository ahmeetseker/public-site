---
// F5.D — Custom 404 (locale-aware).
// Astro SSG: this file is emitted as `dist/404.html` and Vercel/Netlify serve it
// with HTTP 404 for any unmatched route. Build-time `detectLocaleFromPath` here
// resolves to TR (the canonical /404 path), so we ship TR-first HTML and then
// client-side swap to EN when `location.pathname` is under `/en/`. This is the
// only way to get per-locale labels in pure SSG without a host-level rewrite.
import RootLayout from '@/layouts/RootLayout.astro'
import RecentViewedSection from '@/components/recent/RecentViewedSection'
import { detectLocaleFromPath } from '@/i18n'

const locale = detectLocaleFromPath(Astro.url.pathname)
const prefix = locale === 'en' ? '/en' : ''

const labels = locale === 'en'
  ? { title: '404 — Page not found', h1: "We couldn't find that page", desc: "It might have been moved, deleted, or never existed.", search: 'Search listings', home: 'Home', help: 'Help center' }
  : { title: '404 — Sayfa bulunamadı', h1: 'Bu sayfayı bulamadık', desc: 'Sayfa taşınmış, silinmiş ya da hiç var olmamış olabilir.', search: 'Arama yap', home: 'Ana sayfa', help: 'Yardım merkezi' }
---
<RootLayout title={labels.title} description={labels.desc}>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <section class="mx-auto max-w-[800px] px-4 py-16 text-center md:py-24" data-testid="error-404">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">404</p>
    <h1 class="mt-3 text-3xl font-medium text-foreground md:text-4xl" data-i18n="h1">{labels.h1}</h1>
    <p class="mt-4 text-sm text-muted-foreground" data-i18n="desc">{labels.desc}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={`${prefix}/ara`} data-i18n-href="search" data-i18n="search" class="inline-flex items-center gap-2 rounded-full bg-foreground px-4 py-2 text-xs font-medium text-background transition hover:opacity-90">{labels.search}</a>
      <a href={`${prefix}/`} data-i18n-href="home" data-i18n="home" class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-4 py-2 text-xs font-medium text-foreground transition hover:bg-accent">{labels.home}</a>
      <a href={`${prefix}/yardim`} data-i18n-href="help" data-i18n="help" class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-4 py-2 text-xs font-medium text-foreground transition hover:bg-accent">{labels.help}</a>
    </div>
  </section>

  <RecentViewedSection client:visible />

  <script is:inline>
    // Client-side locale swap: the built /404.html is TR; rewrite to EN labels
    // when the user requested an /en/* URL. SSG limitation workaround.
    (function () {
      if (!location.pathname.startsWith('/en/') && location.pathname !== '/en') return
      var EN = {
        h1: "We couldn't find that page",
        desc: 'It might have been moved, deleted, or never existed.',
        search: 'Search listings',
        home: 'Home',
        help: 'Help center',
      }
      var HREF = { search: '/en/ara', home: '/en/', help: '/en/yardim' }
      document.documentElement.setAttribute('lang', 'en-US')
      var titleEl = document.querySelector('title')
      if (titleEl) titleEl.textContent = '404 — Page not found'
      document.querySelectorAll('[data-i18n]').forEach(function (el) {
        var key = el.getAttribute('data-i18n')
        if (key && EN[key]) el.textContent = EN[key]
      })
      document.querySelectorAll('[data-i18n-href]').forEach(function (el) {
        var key = el.getAttribute('data-i18n-href')
        if (key && HREF[key]) el.setAttribute('href', HREF[key])
      })
    })()
  </script>
</RootLayout>
