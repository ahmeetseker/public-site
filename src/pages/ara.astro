---
import RootLayout from '@/layouts/RootLayout.astro'
import SearchHeader from '@/components/search/SearchHeader.astro'
import FilterSidebar from '@/components/search/FilterSidebar.astro'
import ResultsGrid from '@/components/search/ResultsGrid.astro'
import CompareDock from '@/components/search/CompareDock.tsx'
import FilterChips from '@/components/search/FilterChips.tsx'
import SaveSearchButton from '@/components/search/SaveSearchButton.tsx'
import SearchSuggestions from '@/components/search/SearchSuggestions.tsx'
import MobileFilterButton from '@/components/search/MobileFilterButton.tsx'
import MobileFilterSheet from '@/components/search/MobileFilterSheet.tsx'
import RecentViewedCarousel from '@/components/recent/RecentViewedCarousel'
import AraMapShell from '@/components/map/AraMapShell'
import { LISTINGS_V2 as LISTINGS, getHazardBand } from '@landx/data'
import type { Listing, ListingType } from '@landx/data'
import { sortByRelevance } from '@/lib/relevance-score'
import { t, interpolate, detectLocaleFromPath } from '@/i18n'

const locale = detectLocaleFromPath(Astro.url.pathname)
const basePath = locale === 'en' ? '/en' : ''

// ─── parse query params (server-side, SSR via static prerender) ───
const url = new URL(Astro.url)
const q = url.searchParams.get('q')?.trim() ?? ''
const tip = url.searchParams.get('tip') ?? 'Tümü'
const il = url.searchParams.get('il') ?? 'Tümü'
const priceMaxRaw = url.searchParams.get('priceMax') ?? ''
const priceMax = Number(priceMaxRaw) || Infinity
const priceMinRaw = url.searchParams.get('priceMin') ?? ''
const priceMin = Number(priceMinRaw) || 0
const sizeMinRaw = url.searchParams.get('sizeMin') ?? ''
const sizeMin = Number(sizeMinRaw) || 0
const sizeMaxRaw = url.searchParams.get('sizeMax') ?? ''
const sizeMax = Number(sizeMaxRaw) || Infinity
const sort = url.searchParams.get('sort') ?? 'lastUpdate'
// F37 Faz 4.0 / T9 — category filter (sahibinden parity). Default 'arsa' keeps
// legacy behavior because LISTINGS_V2 base entries fall back to category=arsa.
const category = (url.searchParams.get('kat') ?? 'arsa') as 'arsa' | 'konut' | 'villa' | 'isyeri'

// Wave-listing-redesign 1 — yeni multi/boolean filtreler
const imarCsv = url.searchParams.get('imar') ?? '' // "konut,ticari"
const imarSet = imarCsv ? new Set(imarCsv.split(',').filter(Boolean)) : null
const tapu = url.searchParams.get('tapu') ?? '' // "tapulu" | "hisseli"
const wantCephe = url.searchParams.get('cephe') === '1'
const wantSu = url.searchParams.get('su') === '1'
const wantElektrik = url.searchParams.get('elektrik') === '1'
const wantGaz = url.searchParams.get('gaz') === '1'
const depremRiskCsv = url.searchParams.get('depremRisk') ?? ''
const depremRiskSet = depremRiskCsv
  ? new Set(depremRiskCsv.split(',').filter(Boolean))
  : null

// Pagination
const pageRaw = url.searchParams.get('page') ?? '1'
const page = Math.max(1, Number(pageRaw) || 1)
const PAGE_SIZE = 12

const qLower = q.toLocaleLowerCase('tr-TR')

// ─── filter (server-side, deterministic) ───
// Apply category FIRST so subsequent type/city/price/q filters scope to it.
const sourceListings: Listing[] = LISTINGS.filter((l) => (l.category ?? 'arsa') === category)
let filtered: Listing[] = sourceListings.filter((l) => {
  if (l.status !== 'Aktif') return false // public site shows only Aktif
  if (tip !== 'Tümü' && l.type !== tip) return false
  if (il !== 'Tümü' && l.city !== il) return false
  if (l.price > priceMax) return false
  if (qLower) {
    const blob = `${l.id} ${l.title} ${l.city} ${l.district} ${l.tags.join(' ')}`.toLocaleLowerCase('tr-TR')
    if (!blob.includes(qLower)) return false
  }
  return true
})

// ─── sort ───
// Wave F6 / Agent-F6D — `?sort=relevance` is honoured server-side when `q`
// is present. When `q` is empty we fall back to lastUpdate (same as default),
// so the URL stays valid even if a user copies a relevance link with no query.
switch (sort) {
  case 'relevance':
    if (q) {
      filtered = sortByRelevance(filtered, q)
    } else {
      filtered = [...filtered].sort(
        (a, b) => new Date(b.lastUpdate).getTime() - new Date(a.lastUpdate).getTime(),
      )
    }
    break
  case 'price-asc':
    filtered = [...filtered].sort((a, b) => a.price - b.price)
    break
  case 'price-desc':
    filtered = [...filtered].sort((a, b) => b.price - a.price)
    break
  case 'size':
    filtered = [...filtered].sort((a, b) => b.size - a.size)
    break
  case 'lastUpdate':
  default:
    filtered = [...filtered].sort(
      (a, b) => new Date(b.lastUpdate).getTime() - new Date(a.lastUpdate).getTime(),
    )
    break
}

// ─── unique cities + types (computed once at build) ───
const cities = Array.from(new Set(LISTINGS.map((l) => l.city))).sort((a, b) =>
  a.localeCompare(b, 'tr-TR'),
)
const types: ListingType[] = ['İmarlı', 'Tarla', 'Zeytinlik', 'Villa Arsası']

const title = q
  ? interpolate(t('search.titleWithQuery', locale), { q })
  : t('search.title', locale)
const description = q
  ? interpolate(t('search.descriptionWithQuery', locale), { count: filtered.length, q })
  : interpolate(t('search.description', locale), { count: filtered.length })

// Header pill breadcrumb — filtreye göre dinamik
const headerBreadcrumb = [
  { label: t('search.breadcrumbHome', locale), href: `${basePath}/` },
  { label: t('search.breadcrumbSearch', locale), href: il !== 'Tümü' || tip !== 'Tümü' ? `${basePath}/ara` : undefined },
  ...(il !== 'Tümü' ? [{ label: il }] : []),
]
---
<RootLayout title={title} description={description} breadcrumb={headerBreadcrumb}>
  <SearchHeader q={q} tip={tip} il={il} priceMax={priceMaxRaw} resultCount={filtered.length} locale={locale} />

  <div class="mx-auto max-w-[1280px] px-4 py-6 md:py-8">
    <div class="flex flex-col gap-6 md:flex-row md:gap-8">
      {/* Desktop sidebar (hidden on mobile — mobile uses MobileFilterSheet) */}
      <div class="hidden md:block">
        <FilterSidebar
          q={q}
          tip={tip}
          il={il}
          priceMax={priceMaxRaw}
          sort={sort}
          cities={cities}
          types={types}
          resultCount={filtered.length}
          locale={locale}
          category={category}
        />
      </div>
      <div class="min-w-0 flex-1">
        <div class="mb-4">
          <SearchSuggestions client:idle initialQuery={q} locale={locale} basePath={basePath} />
        </div>
        <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
          <FilterChips client:idle />
          <SaveSearchButton client:idle />
        </div>
        <AraMapShell client:only="react" locale={locale} />
        <div data-ara-list>
          <RecentViewedCarousel client:visible />
          <ResultsGrid
            listings={filtered}
            sort={sort}
            q={q}
            tip={tip}
            il={il}
            priceMax={priceMaxRaw}
            locale={locale}
          />
        </div>
      </div>
    </div>
  </div>
  <CompareDock client:load />
  <MobileFilterButton client:idle />
  <MobileFilterSheet
    client:idle
    types={types}
    cities={cities}
    totalCount={filtered.length}
    basePath={basePath}
  />
</RootLayout>

{/*
  F4.B.2 — body-attr CSS drives the list/map/split toggle without rerendering
  the Astro-rendered ResultsGrid. AraMapShell sets `document.body.dataset.viewMode`.
  - map: hide the list, give the map fullbleed.
  - split (md+): constrain the list to half the column so the right side has
    room for the React map island; on mobile we keep the list flowing — split
    isn't exposed on small viewports anyway (see ViewToggle).
*/}
<style is:global>
  body[data-view-mode='map'] [data-ara-list] {
    display: none;
  }
  @media (min-width: 768px) {
    body[data-view-mode='split'] [data-ara-list] {
      max-width: 50%;
    }
  }
</style>
