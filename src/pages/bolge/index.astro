---
import RootLayout from '@/layouts/RootLayout.astro'
import { REGIONS, getRegionListings } from '@landx/data'
import Breadcrumb from '@/components/bolge/Breadcrumb.astro'
import { t, LOCALE_BCP47, detectLocaleFromPath, interpolate } from '@/i18n'

const locale = detectLocaleFromPath(Astro.url.pathname)
const prefix = locale === 'en' ? '/en' : ''

const cards = REGIONS.map((r) => ({
  ...r,
  count: getRegionListings(r).length,
}))

const totalListings = cards.reduce((acc, r) => acc + r.count, 0)

const title = t('regionHub.title', locale)
const description = locale === 'en'
  ? `${REGIONS.length} popular regions, ${totalListings} verified listings. Ayvalık, Çeşme, Datça, Fethiye, Urla, Marmaris, Söke, Edremit — discover on arsam.net.`
  : `${REGIONS.length} popüler bölge, ${totalListings} doğrulanmış ilan. Ayvalık, Çeşme, Datça, Fethiye, Urla, Marmaris, Söke, Edremit — arsam.net'te tek noktadan keşfedin.`

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  inLanguage: LOCALE_BCP47[locale],
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('search.breadcrumbHome', locale), item: new URL(`${prefix}/`, Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: t('regionHub.heading', locale), item: new URL(`${prefix}/bolge`, Astro.site).toString() },
  ],
}

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  inLanguage: LOCALE_BCP47[locale],
  itemListElement: REGIONS.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`${prefix}/bolge/${r.slug}`, Astro.site).toString(),
    name: `${r.name}, ${r.city}`,
  })),
}
---

<RootLayout title={title} description={description}>
  <Breadcrumb />

  <section class="border-b border-border bg-card/40">
    <div class="mx-auto max-w-[1280px] px-4 py-16 md:py-20">
      <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
        {locale === 'en' ? 'REGION GUIDE' : 'BÖLGE REHBERİ'}
      </div>
      <h1 class="mt-3 font-serif text-4xl font-normal tracking-tight md:text-5xl">
        {locale === 'en'
          ? <Fragment>Popular <em class="font-serif italic font-normal">regions</em></Fragment>
          : <Fragment>Popüler <em class="font-serif italic font-normal">bölgeler</em></Fragment>
        }
      </h1>
      <p class="mt-5 max-w-[68ch] text-base leading-relaxed text-muted-foreground md:text-lg">
        {t('regionHub.intro', locale)}
      </p>
      <div class="mt-6 font-mono text-xs uppercase tracking-wider text-muted-foreground">
        {locale === 'en'
          ? `${REGIONS.length} regions · ${totalListings} active listings`
          : `${REGIONS.length} bölge · ${totalListings} aktif ilan`}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1280px] px-4 py-16 md:py-20">
    <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
      {
        cards.map((r) => (
          <a
            href={`${prefix}/bolge/${r.slug}`}
            class="group flex flex-col justify-between rounded-xl border border-border bg-card p-4 transition hover:bg-accent hover:text-accent-foreground md:p-5"
          >
            <div>
              <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground group-hover:text-accent-foreground/70">
                {r.city}
              </div>
              <div class="mt-1 font-serif text-xl tracking-tight md:text-2xl">{r.name}</div>
            </div>
            <div class="mt-6 flex items-center justify-between">
              <span class="text-xs text-muted-foreground group-hover:text-accent-foreground/70">
                {interpolate(t('regionHub.listingCount', locale), { count: r.count })}
              </span>
              <svg
                class="h-3.5 w-3.5 text-muted-foreground transition group-hover:translate-x-0.5 group-hover:text-accent-foreground"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
</RootLayout>
