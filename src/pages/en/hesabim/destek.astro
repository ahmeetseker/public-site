---
import RootLayout from '@/layouts/RootLayout.astro'
import AccountLayout from '@/layouts/AccountLayout.astro'
import AuthGuard from '@/components/account/AuthGuard.astro'
import PageHeader from '@/components/account/PageHeader.astro'
import SupportTickets from '@/components/account/SupportTickets.tsx'

const locale = 'en' as const
---

<RootLayout
  locale={locale}
  title="Support — arsam.net"
  description="Open and track your arsam.net support tickets."
>
  <AuthGuard />
  <AccountLayout active="destek">
    <PageHeader
      eyebrow="ACCOUNT · SUPPORT"
      title="Support tickets"
      description="Reach our support team — we typically respond within 24 hours."
    />
    <SupportTickets client:visible />
  </AccountLayout>
</RootLayout>
