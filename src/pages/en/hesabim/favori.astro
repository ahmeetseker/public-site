---
import RootLayout from '@/layouts/RootLayout.astro'
import AccountLayout from '@/layouts/AccountLayout.astro'
import AuthGuard from '@/components/account/AuthGuard.astro'
import PageHeader from '@/components/account/PageHeader.astro'
import FavoriteCard from '@/components/account/FavoriteCard.astro'
import FavoritesList from '@/components/account/FavoritesList.tsx'
import { FAVORITE_LISTING_IDS, LISTINGS } from '@landx/data'
import { interpolate, t } from '@/i18n'

const locale = 'en' as const

const favorites = FAVORITE_LISTING_IDS
  .map((id) => LISTINGS.find((l) => l.id === id))
  .filter((l): l is NonNullable<typeof l> => l !== undefined)

const listingDict = Object.fromEntries(
  LISTINGS.map((l) => [
    l.id,
    {
      id: l.id,
      title: l.title,
      city: l.city,
      district: l.district,
      type: l.type,
      size: l.size,
      price: l.price,
    },
  ]),
)
---

<RootLayout
  locale={locale}
  title="My favorites — arsam.net"
  description="Land, olive grove and field listings you saved on arsam.net."
>
  <AuthGuard />
  <AccountLayout active="favori">
    <PageHeader
      eyebrow="ACCOUNT · FAVORITES"
      title={t('account.favoritesPage.title', locale)}
      emphasis={interpolate(t('account.favoritesPage.count', locale), { count: favorites.length })}
      description={t('account.favoritesPage.description', locale)}
    />

    <section data-favorites-island-wrap="" class="pb-6">
      <FavoritesList listings={listingDict} client:idle />
    </section>

    <div class="mb-6 border-t border-dashed border-border pt-6">
      <h2 class="font-serif text-base tracking-tight">{t('account.favoritesPage.seedHeading', locale)}</h2>
      <p class="font-mono text-xs uppercase tracking-wide text-muted-foreground">
        {t('account.favoritesPage.seedNote', locale)}
      </p>
    </div>

    {favorites.length > 0 ? (
      <>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {favorites.map((listing) => (
            <FavoriteCard listing={listing} />
          ))}
        </div>

        <div class="mt-8 rounded-2xl border border-dashed border-border bg-card/50 p-5 text-center text-sm text-muted-foreground">
          {t('account.favoritesPage.addNew', locale)}
          {' '}
          <a href="/en/ara" class="font-medium text-foreground underline underline-offset-2">{t('account.favoritesPage.searchLand', locale)} →</a>
        </div>
      </>
    ) : (
      <div class="flex flex-col items-center gap-3 rounded-2xl border border-dashed border-border bg-card/50 p-12 text-center">
        <span class="font-serif text-4xl font-normal text-muted-foreground" aria-hidden="true">♡</span>
        <h2 class="font-serif text-xl tracking-tight">{t('account.favoritesPage.empty', locale)}</h2>
        <p class="max-w-sm text-sm text-muted-foreground">
          {t('account.favoritesPage.emptyBody', locale)}
        </p>
        <a
          href="/en/ara"
          class="mt-2 inline-flex items-center rounded-xl bg-accent px-4 py-2 text-sm font-medium text-accent-foreground transition-opacity hover:opacity-90"
        >
          {t('account.favoritesPage.emptyCta', locale)} →
        </a>
      </div>
    )}
  </AccountLayout>
</RootLayout>
