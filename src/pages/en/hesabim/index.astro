---
import RootLayout from '@/layouts/RootLayout.astro'
import AccountLayout from '@/layouts/AccountLayout.astro'
import AuthGuard from '@/components/account/AuthGuard.astro'
import PageHeader from '@/components/account/PageHeader.astro'
import StatsCards from '@/components/account/StatsCards.astro'
import ActivityFeed from '@/components/account/ActivityFeed.astro'
import RegionsOfInterest from '@/components/account/RegionsOfInterest.astro'
import AccountStats from '@/components/account/AccountStats.tsx'
import RecentActivity from '@/components/account/RecentActivity.tsx'
import { BUYER } from '@landx/data'
import { interpolate, t } from '@/i18n'

const locale = 'en' as const
const firstName = BUYER.name.split(' ')[0]
---

<RootLayout
  locale={locale}
  title={t('account.pageTitle', locale)}
  description="arsam.net account overview, favorites, saved searches and recent activity."
>
  <AuthGuard />
  <AccountLayout active="dashboard">
    <PageHeader
      eyebrow="ACCOUNT · OVERVIEW"
      title={interpolate(t('account.dashboard.welcomeBack', locale), { name: firstName })}
      emphasis={t('account.dashboard.cta', locale)}
      description={t('account.dashboard.description', locale)}
    />

    <div class="flex flex-col gap-6">
      <StatsCards />

      <section data-account-stats-island="">
        <header class="flex items-baseline justify-between gap-2 pb-2">
          <h2 class="font-serif text-lg tracking-tight">{t('account.dashboard.yourAccount', locale)}</h2>
          <span class="font-mono text-xs uppercase tracking-wide text-muted-foreground">
            {t('account.dashboard.liveInBrowser', locale)}
          </span>
        </header>
        <AccountStats client:idle />
      </section>

      <div class="grid gap-6 lg:grid-cols-[1.2fr_1fr]">
        <ActivityFeed />
        <RegionsOfInterest />
      </div>

      <RecentActivity client:idle />

      <!-- Quick actions -->
      <section class="flex flex-wrap items-center gap-3 rounded-2xl border border-border bg-card p-5">
        <div class="min-w-0 flex-1">
          <h2 class="font-serif text-lg tracking-tight">{t('account.dashboard.quickActions', locale)}</h2>
          <p class="text-xs text-muted-foreground">{t('account.dashboard.quickActionsDesc', locale)}</p>
        </div>
        <a
          href="/en/ara"
          class="rounded-xl border border-border bg-background px-3 py-2 text-sm font-medium transition hover:bg-foreground/5"
        >
          {t('account.dashboard.newSearch', locale)} →
        </a>
        <a
          href="/en/hesabim/favori"
          class="rounded-xl border border-border bg-background px-3 py-2 text-sm font-medium transition hover:bg-foreground/5"
        >
          {t('account.dashboard.seeFavorites', locale)}
        </a>
        <a
          href="/en/hesabim/mesajlar"
          class="rounded-xl bg-accent px-3 py-2 text-sm font-medium text-accent-foreground transition-opacity hover:opacity-90"
        >
          {t('account.dashboard.openMessages', locale)}
        </a>
      </section>
    </div>
  </AccountLayout>
</RootLayout>
