---
import RootLayout from '@/layouts/RootLayout.astro'
import AccountLayout from '@/layouts/AccountLayout.astro'
import AuthGuard from '@/components/account/AuthGuard.astro'
import PageHeader from '@/components/account/PageHeader.astro'
import ConversationList from '@/components/account/ConversationList.astro'
import ConversationThread from '@/components/account/ConversationThread.astro'
import MessagesView from '@/components/account/MessagesView.tsx'
import { MOCK_CONVERSATIONS } from '@landx/data'
import { interpolate, t } from '@/i18n'

const locale = 'en' as const

const activeId = MOCK_CONVERSATIONS[0]?.id ?? ''
const activeConversation = MOCK_CONVERSATIONS.find((c) => c.id === activeId)
const totalUnread = MOCK_CONVERSATIONS.reduce((s, c) => s + c.unread, 0)
---

<RootLayout
  locale={locale}
  title="My messages — arsam.net"
  description="Conversations with real-estate offices on arsam.net."
>
  <AuthGuard />
  <AccountLayout active="mesajlar">
    <PageHeader
      eyebrow="ACCOUNT · MESSAGES"
      title={t('account.messagesPage.title', locale)}
      emphasis={interpolate(t('account.messagesPage.count', locale), { count: MOCK_CONVERSATIONS.length })}
      description={
        totalUnread > 0
          ? interpolate(t('account.messagesPage.unread', locale), { count: totalUnread })
          : t('account.messagesPage.allRead', locale)
      }
    />

    <!-- Wave F9.B — real-time mock island (polling + typing + read receipts). -->
    <section data-messages-island-wrap="" class="pb-6">
      <MessagesView client:idle />
    </section>

    <details class="mt-6 rounded-2xl border border-dashed border-border bg-card/50 p-4">
      <summary class="cursor-pointer font-mono text-xs uppercase tracking-wide text-muted-foreground">
        {t('account.messagesPage.staticFallback', locale)} ▾
      </summary>
      <div class="mt-4 grid gap-6 md:grid-cols-[320px_1fr]">
        <div class="md:max-h-[640px] md:overflow-y-auto">
          <ConversationList activeId={activeId} />
          <button
            id="new-msg-btn"
            type="button"
            data-msg={t('account.messagesPage.newAlert', locale)}
            class="mt-4 w-full rounded-xl border border-dashed border-border bg-card/50 px-4 py-3 text-sm font-medium text-muted-foreground transition hover:border-foreground/20 hover:text-foreground"
          >
            + {t('account.messagesPage.newCta', locale)}
          </button>
        </div>

        <div class="md:min-h-[640px]">
          {activeConversation ? (
            <ConversationThread conversation={activeConversation} />
          ) : (
            <div class="flex h-full flex-col items-center justify-center gap-2 rounded-2xl border border-dashed border-border bg-card/50 p-12 text-center">
              <span class="font-serif text-4xl font-normal text-muted-foreground" aria-hidden="true">✉</span>
              <h2 class="font-serif text-xl tracking-tight">{t('account.messagesPage.empty', locale)}</h2>
              <p class="max-w-sm text-sm text-muted-foreground">
                {t('account.messagesPage.emptyBody', locale)}
              </p>
            </div>
          )}
        </div>
      </div>
    </details>
  </AccountLayout>

  <script is:inline>
    (function () {
      const btn = document.getElementById('new-msg-btn')
      if (btn) {
        btn.addEventListener('click', function () {
          alert(btn.getAttribute('data-msg') || '')
        })
      }
    })()
  </script>
</RootLayout>
