---
import RootLayout from '@/layouts/RootLayout.astro'
import FaqAccordion from '@/components/secondary/FaqAccordion.astro'
import { t, LOCALE_BCP47, detectLocaleFromPath } from '@/i18n'

const locale = detectLocaleFromPath(Astro.url.pathname)
// TODO i18n: FAQ body prose is TR-canonical and stays Turkish on /en/sss too
// (acceptable per Faz 9.13.b exit criteria — stylized SEO-prose).

type FaqItem = { q: string; a: string }
type FaqSection = { id: string; title: string; items: FaqItem[] }

const sections: FaqSection[] = [
  {
    id: 'genel',
    title: '1. Genel',
    items: [
      {
        q: 'arsam.net nedir?',
        a: 'arsam.net, Türkiye\'nin <strong>arsa, tarla ve zeytinlik</strong> taşınmazlarına odaklı dijital pazaryeridir. Konut/işyeri ilanı yayımlamak yerine yalnızca araziye yoğunlaşır; emlak ofislerini doğrular, bölge bazlı pazar fiyat verisi sunar.',
      },
      {
        q: 'Sahibinden.com\'dan farkı ne?',
        a: 'Sahibinden.com geniş bir pazaryeridir; arsam.net ise <strong>tek kategoride uzmanlaşmış</strong> bir dikey pazaryeridir. Filtreler (imar durumu, hisse, parsel no, yola cephe vb.) ve bölge sayfalarındaki ortalama m² fiyat grafiği bu odağın sonucudur.',
      },
      {
        q: 'Hangi bölgelerde aktif?',
        a: 'MVP aşamasında 8 öne çıkan bölge için sayfalarımız var (Çeşme, Bodrum, Datça, Urla, Foça, Şile, Ayvalık, Marmaris). Ülke geneli ilan listelemesi açıktır; bölge sayfaları zamanla artacaktır.',
      },
      {
        q: 'Hizmet ücretsiz mi?',
        a: 'MVP sürümünde tüm arama, ilan inceleme ve iletişim özellikleri ücretsizdir. İlan vermek için pro ofis hesabı (ücretli) <strong>Faz 2</strong>\'de devreye alınacaktır.',
      },
    ],
  },
  {
    id: 'arama',
    title: '2. Arsa arama',
    items: [
      {
        q: 'Filtreleri nasıl kullanırım?',
        a: 'Sol kenardaki filtre paneli üzerinden il/ilçe, fiyat aralığı, m² aralığı, imar durumu (konut/ticari/tarım), tapu cinsi (müstakil/hisseli), yola cephe ve elektrik/su durumu seçebilirsiniz. Tüm filtreler URL\'ye yazılır, paylaşılabilir.',
      },
      {
        q: 'Bölge sayfalarındaki market fiyat verisi nereden?',
        a: '<strong>Şu an demo verisidir.</strong> Veriler son 12 ayda yayımlanan ve eşleşen kriterlere sahip ilanların m² fiyat medyanından üretilecektir (Faz 2). Resmi tapu/satış kaydı kaynağı değildir, gösterge niteliğindedir.',
      },
      {
        q: 'Bir ilan hâlâ duruyor mu nasıl anlarım?',
        a: 'İlan detay sayfasında <strong>"Aktif"</strong>, <strong>"Pasif"</strong> ve <strong>"Satıldı"</strong> rozetleri görünür. Yenilenme tarihi 60 günden eski olan ilanlar otomatik pasifleşir. Ofis bu durumu güncelleyebilir.',
      },
      {
        q: 'Aramalarımı kaydedebilir miyim?',
        a: 'Evet. Üye girişi yaptıktan sonra arama sayfasında "Aramayı kaydet" butonu çıkar. Kayıtlı aramalarınız <a href="/hesabim/aramalar">/hesabim/aramalar</a> altında listelenir; yeni eşleşen ilan çıktığında bildirim alabilirsiniz (Faz 2).',
      },
      {
        q: 'Harita üzerinden arama var mı?',
        a: 'Bölge sayfalarında (örn. <a href="/bolge/cesme">/bolge/cesme</a>) ilanların harita üzerinde dağılımı gösterilir. Geniş kapsamlı çizim-tabanlı harita araması Faz 3 planındadır.',
      },
    ],
  },
  {
    id: 'ilan-verme',
    title: '3. İlan verme',
    items: [
      {
        q: 'İlan vermek ücretli mi?',
        a: 'MVP sürümünde ilan verme akışı (<a href="/ilan-ver">/ilan-ver</a>) <strong>demo</strong> niteliğindedir. <strong>Faz 2</strong>\'de pro emlak ofisi hesabına bağlanacak; bireysel sahipler için ayrıca paket planlanmaktadır.',
      },
      {
        q: 'İlanım ne kadar sürede yayınlanır?',
        a: 'Doğrulanmış ofis hesapları için ilan kaydı oluştuktan sonra yayın anlıktır. Yeni kurulan hesaplar ilk 1-2 ilan için manuel inceleme (24 saat içinde) sürecinden geçer.',
      },
      {
        q: 'Fotoğraf zorunlu mu?',
        a: 'En az 1 fotoğraf zorunludur; öneri 5-8 görsel + 1 parsel/uydu çizim görseli. Fotoğrafsız ilanlar arama listelerinde alt sıralarda gösterilir.',
      },
      {
        q: 'Sahibinden.com\'a otomatik yayın var mı?',
        a: 'Hayır. arsam.net bağımsız bir platformdur; harici listeleme servislerine otomatik aktarım yapmaz. İsterseniz aynı ilanı manuel olarak başka platformlarda da yayımlayabilirsiniz.',
      },
      {
        q: 'İlanımı nasıl güncellerim?',
        a: 'Ofis paneli (<a href="/panel">/panel</a>) üzerinden mevcut ilanlarınızı düzenleyebilir, pasifleştirebilir veya "Satıldı" olarak işaretleyebilirsiniz.',
      },
    ],
  },
  {
    id: 'iletisim-guven',
    title: '4. İletişim ve güven',
    items: [
      {
        q: 'Emlak ofisleri nasıl doğrulanıyor?',
        a: 'Yeni ofis kaydında <strong>vergi numarası, MERSİS no, yetkili kişi telefon doğrulaması</strong> ve tabela fotoğrafı talep edilir. İlk 30 günde manuel inceleme yapılır; doğrulanmış ofislerde <em class="font-serif italic">"Doğrulanmış"</em> rozeti görünür.',
      },
      {
        q: 'Dolandırıcılığa karşı ne yapılıyor?',
        a: 'Aşırı düşük fiyat anomalisi, kopya ilan, doğrulanmamış telefon eşleşmesi otomatik bayrak yapılır. Şüpheli ilanları detay sayfasındaki "Şikâyet et" linki ile bize bildirebilirsiniz. KVKK ekibi 48 saat içinde dönüş yapar.',
      },
      {
        q: 'Direkt sahibinden satılan ilan var mı?',
        a: 'MVP sürümünde tüm ilanlar <strong>doğrulanmış emlak ofisleri</strong> üzerinden yayımlanır. Bireysel sahip-satıcı kanalı Faz 3\'te değerlendirilecektir.',
      },
      {
        q: 'İlan sahibiyle nasıl iletişim kurarım?',
        a: 'Detay sayfasındaki "Ofise mesaj at" formu üzerinden. Telefon numarası, ofis profilinde açıkça gösterilir; ek olarak WhatsApp linki sunulabilir.',
      },
    ],
  },
  {
    id: 'hesap-gizlilik',
    title: '5. Hesap ve gizlilik',
    items: [
      {
        q: 'Verilerim nasıl korunuyor?',
        a: 'arsam.net <strong>6698 sayılı KVKK</strong>\'ya tam uyumludur. Detaylı bilgi için <a href="/kvkk">KVKK Aydınlatma Metni</a>\'mizi inceleyin. Hassas veri (T.C., vergi no) yalnızca yasal yükümlülük çerçevesinde, şifreli olarak saklanır.',
      },
      {
        q: 'Aramalarım kaydediliyor mu?',
        a: 'Üye girişi olmadan yapılan aramalar yalnızca toplam metrik için (anonim) tutulur. Üye iseniz son aramalarınız hesabınızda görünür; "Aramayı kaydet" yapmadığınız sürece bildirim üretmez.',
      },
      {
        q: 'Hesabımı silebilir miyim?',
        a: 'Evet. <a href="/hesabim/profil">/hesabim/profil</a> altındaki "Hesabımı sil" butonu ile 30 günlük yedek süresi başlatılır; bu süre içinde geri alabilirsiniz. Sonrasında KVKK m.7 kapsamında verileriniz yok edilir.',
      },
      {
        q: 'Pazarlama e-postası geliyor, nasıl çıkarım?',
        a: 'Her bültenin altındaki "Abonelikten çık" linkiyle tek tıkla çıkabilir veya profil sayfasından pazarlama izinlerinizi yönetebilirsiniz.',
      },
      {
        q: 'Çerez tercihimi nasıl güncellerim?',
        a: 'Footer\'daki "Çerez tercihleri" linkinden veya <a href="/cerez-politikasi">/cerez-politikasi</a> sayfasından zorunlu olmayan çerezleri istediğiniz zaman kapatabilirsiniz.',
      },
    ],
  },
]

// Aggregate Q&A count for telemetry / coordination doc
const totalQA = sections.reduce((sum, s) => sum + s.items.length, 0)

// Build FAQPage JSON-LD
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: LOCALE_BCP47[locale],
  mainEntity: sections.flatMap((s) =>
    s.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        // Strip HTML tags for the structured-data text (Google prefers plain)
        text: item.a.replace(/<[^>]+>/g, ''),
      },
    })),
  ),
}

const headerBreadcrumb = [
  { label: 'Home', href: '/en/' },
  { label: 'FAQ' },
]
---
<RootLayout
  title={t('faqPage.title', locale)}
  description={t('faqPage.description', locale)}
  breadcrumb={headerBreadcrumb}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} slot="head" />

  <article class="mx-auto max-w-[1200px] px-4 py-12 lg:py-16">
    <header class="mb-10">
      <div class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">YARDIM · SSS</div>
      <h1 class="font-serif text-4xl font-normal tracking-tight md:text-5xl">Sıkça sorulan <em class="font-serif italic font-normal">sorular</em></h1>
      <p class="mt-3 max-w-[60ch] text-sm leading-relaxed text-muted-foreground">
        arsam.net hakkında en sık aldığımız {totalQA} soruyu burada topladık. Cevabını bulamadığınız bir konu varsa <a class="underline underline-offset-2" href="/iletisim">iletişim sayfamızdan</a> bize yazabilirsiniz.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[240px_1fr]">
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <details class="group rounded-2xl border border-border bg-card p-4 lg:open:block" open>
          <summary class="cursor-pointer list-none font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground lg:cursor-default">İçindekiler</summary>
          <nav class="mt-3 flex flex-col gap-1.5 text-sm">
            {sections.map((s) => (
              <a href={`#${s.id}`} class="text-muted-foreground transition hover:text-foreground">{s.title}</a>
            ))}
          </nav>
        </details>
      </aside>

      <div class="max-w-[68ch]">
        {sections.map((s) => (
          <FaqAccordion id={s.id} title={s.title} items={s.items} />
        ))}

        <div class="mt-10 rounded-2xl border border-border bg-card/40 p-6">
          <div class="font-serif text-lg font-medium">Aradığını bulamadın mı?</div>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
            Bize doğrudan ulaşabilirsin — 2 iş günü içinde dönüş yapıyoruz.
          </p>
          <a href="/iletisim" class="mt-4 inline-flex items-center gap-2 rounded-full border border-border bg-card px-4 py-2 text-sm font-medium transition hover:bg-accent">
            İletişim formuna git →
          </a>
        </div>
      </div>
    </div>
  </article>
</RootLayout>
