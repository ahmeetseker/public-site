---
import RootLayout from '@/layouts/RootLayout.astro'
import AccountLayout from '@/layouts/AccountLayout.astro'
import AuthGuard from '@/components/account/AuthGuard.astro'
import PageHeader from '@/components/account/PageHeader.astro'
import AiNotificationPrefForm from '@/components/ai/AiNotificationPrefForm.tsx'
import { detectLocaleFromPath } from '@/i18n'

const locale = detectLocaleFromPath(Astro.url.pathname)
---

<RootLayout
  title={locale === 'en' ? 'AI preferences — arsam.net' : 'AI tercihleri — arsam.net'}
  description={locale === 'en'
    ? 'Smart timing, quiet hours, and AI-routed notification matrix per event type.'
    : 'Akıllı zamanlama, sessiz saatler ve AI yönlendirmeli bildirim matrisi.'}
>
  <AuthGuard />
  <AccountLayout active="ai-tercihleri">
    <PageHeader
      eyebrow="HESAP · AI TERCİHLERİ"
      title="Akıllı bildirim ayarları"
      emphasis="AI ne zaman yazsın?"
      description="AI, hangi olayda hangi kanaldan ulaşacağına ve sessiz saatlerine kararını sen verirsin."
    />
    <AiNotificationPrefForm client:only="react" />
  </AccountLayout>
</RootLayout>
