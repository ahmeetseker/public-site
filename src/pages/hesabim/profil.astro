---
import RootLayout from '@/layouts/RootLayout.astro'
import AccountLayout from '@/layouts/AccountLayout.astro'
import AuthGuard from '@/components/account/AuthGuard.astro'
import PageHeader from '@/components/account/PageHeader.astro'
import ProfileForm from '@/components/account/ProfileForm.tsx'
import DeleteAccountDialog from '@/components/account/DeleteAccountDialog.tsx'
import { BUYER } from '@landx/data'
import { detectLocaleFromPath } from '@/i18n'

const locale = detectLocaleFromPath(Astro.url.pathname)
const isEn = locale === 'en'

const joinedFormatted = new Date(BUYER.joinedISO).toLocaleDateString(isEn ? 'en-US' : 'tr-TR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
})

// Notification toggles — labels localized per F5.A.
const NOTIF_TOGGLES = isEn
  ? [
      { id: 'notif-match', label: 'New match', desc: 'When your saved searches find new listings', defaultOn: true },
      { id: 'notif-price', label: 'Price change', desc: 'When the price of a favorite changes', defaultOn: true },
      { id: 'notif-msg', label: 'Office message', desc: 'When an office sends you a message', defaultOn: true },
      { id: 'notif-weekly', label: 'Weekly digest', desc: 'Every Monday morning, summary from your regions', defaultOn: false },
    ]
  : [
      { id: 'notif-match', label: 'Yeni eşleşme', desc: 'Kayıtlı aramaların yeni ilanlar bulduğunda', defaultOn: true },
      { id: 'notif-price', label: 'Fiyat değişikliği', desc: 'Favorilerin fiyatı değiştiğinde', defaultOn: true },
      { id: 'notif-msg', label: 'Ofis mesajı', desc: 'Bir ofis sana mesaj yazdığında', defaultOn: true },
      { id: 'notif-weekly', label: 'Haftalık özet', desc: 'Her Pazartesi sabahı, ilgilendiğin bölgelerden özet', defaultOn: false },
    ]

const labels = isEn
  ? {
      eyebrow: 'ACCOUNT · SETTINGS',
      titleMain: 'Profile',
      titleEmphasis: 'settings',
      joined: `Member since ${joinedFormatted}`,
      notifTitle: 'Notification preferences',
      notifDesc: 'Choose which notifications you want to receive by email.',
      securityTitle: 'Security',
      securityDesc: 'Password and two-factor authentication.',
      passwordLabel: 'Password',
      passwordMeta: 'Last changed: unknown',
      passwordCta: 'Change password',
      twoFaLabel: 'Two-factor authentication (2FA)',
      twoFaDesc: 'Extra protection via SMS or authenticator app.',
      twoFaAria: 'Two-factor authentication',
      kvkkTitle: 'KVKK & privacy',
      kvkkBody: 'See',
      kvkkLink: 'KVKK Notice',
      kvkkBody2: 'about your data.',
      exportData: 'Download my data (JSON)',
      deleteAccount: 'Delete my account',
      passwordAlert: 'Password change ships in Phase 10.2.',
      editAlert: 'Editing ships in Phase 10.2.',
      exportAlert: 'Data download ships in Phase 10.2 — KVKK-mandated, in progress.',
      deleteConfirm: 'Permanently delete your account? This cannot be undone.',
      deleteAlert: 'Account deletion ships in Phase 10.2.',
    }
  : {
      eyebrow: 'HESAP · AYARLAR',
      titleMain: 'Profil',
      titleEmphasis: 'ayarları',
      joined: `Üyelik tarihi: ${joinedFormatted}`,
      notifTitle: 'Bildirim tercihleri',
      notifDesc: 'E-posta ile hangi bildirimleri almak istediğini seç.',
      securityTitle: 'Güvenlik',
      securityDesc: 'Parola ve iki adımlı doğrulama.',
      passwordLabel: 'Parola',
      passwordMeta: 'Son değişiklik: bilinmiyor',
      passwordCta: 'Parolayı değiştir',
      twoFaLabel: 'İki adımlı doğrulama (2FA)',
      twoFaDesc: 'SMS veya kimlik doğrulayıcı uygulama ile ek koruma.',
      twoFaAria: 'İki adımlı doğrulama',
      kvkkTitle: 'KVKK & gizlilik',
      kvkkBody: 'Verilerin hakkında',
      kvkkLink: 'KVKK Aydınlatma Metni',
      kvkkBody2: "'ne göz at.",
      exportData: 'Verilerimi indir (JSON)',
      deleteAccount: 'Hesabımı sil',
      passwordAlert: "Parola değişikliği Faz 10.2'de aktif olacak.",
      editAlert: "Düzenleme Faz 10.2'de aktif olacak.",
      exportAlert: "Veri indirme Faz 10.2'de aktif olacak — KVKK gereği zorunlu, hazırlanıyor.",
      deleteConfirm: 'Hesabını kalıcı olarak silmek istediğine emin misin? Bu işlem geri alınamaz.',
      deleteAlert: "Hesap silme Faz 10.2'de aktif olacak.",
    }

const kvkkHref = isEn ? '/en/kvkk' : '/kvkk'
---

<RootLayout
  title={isEn ? 'Profile settings — arsam.net' : 'Profil ayarları — arsam.net'}
  description={isEn ? 'arsam.net account, notification preferences, security and KVKK settings.' : 'arsam.net hesap bilgileri, bildirim tercihleri, güvenlik ve KVKK ayarları.'}
>
  <AuthGuard />
  <AccountLayout active="profil">
    <PageHeader
      eyebrow={labels.eyebrow}
      title={labels.titleMain}
      emphasis={labels.titleEmphasis}
      description={labels.joined}
    />

    <!-- Wave F3 / Agent-F3E — localStorage-backed profile form (bilingual in F5.A) -->
    <section data-profile-island-wrap="" class="pb-6">
      <ProfileForm client:idle />
    </section>

    <section data-delete-island-wrap="" class="pb-6">
      <DeleteAccountDialog client:idle />
    </section>

    <div class="flex flex-col gap-5">
      <!-- Notification preferences -->
      <section class="rounded-2xl border border-border bg-card p-5">
        <div class="pb-3">
          <h2 class="font-serif text-xl tracking-tight">{labels.notifTitle}</h2>
          <p class="text-xs text-muted-foreground">{labels.notifDesc}</p>
        </div>
        <ul class="flex flex-col divide-y divide-border">
          {NOTIF_TOGGLES.map((toggle) => (
            <li class="flex items-center justify-between gap-4 py-3">
              <div class="min-w-0 flex-1">
                <label for={toggle.id} class="block text-sm font-medium">{toggle.label}</label>
                <p class="text-xs text-muted-foreground">{toggle.desc}</p>
              </div>
              <input
                id={toggle.id}
                type="checkbox"
                checked={toggle.defaultOn}
                class="h-4 w-4 rounded border-border accent-foreground"
                aria-label={toggle.label}
              />
            </li>
          ))}
        </ul>
      </section>

      <!-- Security -->
      <section class="rounded-2xl border border-border bg-card p-5">
        <div class="pb-3">
          <h2 class="font-serif text-xl tracking-tight">{labels.securityTitle}</h2>
          <p class="text-xs text-muted-foreground">{labels.securityDesc}</p>
        </div>
        <ul class="flex flex-col divide-y divide-border">
          <li class="flex items-center justify-between gap-4 py-3">
            <div>
              <div class="text-sm font-medium">{labels.passwordLabel}</div>
              <p class="text-xs text-muted-foreground">{labels.passwordMeta}</p>
            </div>
            <button
              id="sec-password-btn"
              type="button"
              data-msg={labels.passwordAlert}
              class="rounded-xl border border-border bg-background px-3 py-1.5 text-xs font-medium transition hover:bg-foreground/5"
            >
              {labels.passwordCta}
            </button>
          </li>
          <li class="flex items-center justify-between gap-4 py-3">
            <div>
              <div class="text-sm font-medium">{labels.twoFaLabel}</div>
              <p class="text-xs text-muted-foreground">{labels.twoFaDesc}</p>
            </div>
            <input
              id="sec-2fa"
              type="checkbox"
              class="h-4 w-4 rounded border-border accent-foreground"
              aria-label={labels.twoFaAria}
            />
          </li>
        </ul>
      </section>

      <!-- KVKK & privacy -->
      <section class="rounded-2xl border border-rose-500/20 bg-rose-500/[0.03] p-5 dark:border-rose-400/20 dark:bg-rose-400/[0.03]">
        <div class="pb-3">
          <h2 class="font-serif text-xl tracking-tight">{labels.kvkkTitle}</h2>
          <p class="text-xs text-muted-foreground">
            {labels.kvkkBody}
            {' '}
            <a href={kvkkHref} class="underline underline-offset-2 hover:text-foreground">{labels.kvkkLink}</a>{labels.kvkkBody2}
          </p>
        </div>
        <div class="flex flex-col gap-2 sm:flex-row">
          <button
            id="kvkk-export-btn"
            type="button"
            data-msg={labels.exportAlert}
            class="rounded-xl border border-border bg-background px-4 py-2 text-sm font-medium transition hover:bg-foreground/5"
          >
            {labels.exportData}
          </button>
          <button
            id="kvkk-delete-btn"
            type="button"
            data-confirm={labels.deleteConfirm}
            data-msg={labels.deleteAlert}
            class="rounded-xl border border-rose-500/40 bg-rose-500/10 px-4 py-2 text-sm font-medium text-rose-700 transition hover:bg-rose-500/15 dark:border-rose-400/40 dark:bg-rose-400/10 dark:text-rose-300"
          >
            {labels.deleteAccount}
          </button>
        </div>
      </section>
    </div>
  </AccountLayout>

  <script is:inline>
    (function () {
      function bindAlert(id) {
        const el = document.getElementById(id)
        if (el) {
          el.addEventListener('click', function () {
            alert(el.getAttribute('data-msg') || '')
          })
        }
      }
      bindAlert('sec-password-btn')
      bindAlert('kvkk-export-btn')
      const del = document.getElementById('kvkk-delete-btn')
      if (del) {
        del.addEventListener('click', function () {
          if (confirm(del.getAttribute('data-confirm') || '')) {
            alert(del.getAttribute('data-msg') || '')
          }
        })
      }
    })()
  </script>
</RootLayout>
