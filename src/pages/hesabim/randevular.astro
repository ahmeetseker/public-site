---
import RootLayout from '@/layouts/RootLayout.astro'
import AccountLayout from '@/layouts/AccountLayout.astro'
import AuthGuard from '@/components/account/AuthGuard.astro'
import PageHeader from '@/components/account/PageHeader.astro'
import ViewingsList from '@/components/account/ViewingsList.tsx'
import { detectLocaleFromPath } from '@/i18n'

const locale = detectLocaleFromPath(Astro.url.pathname)
---

<RootLayout
  title={locale === 'en' ? 'My viewings — arsam.net' : 'Görme randevularım — arsam.net'}
  description={locale === 'en' ? 'Scheduled parcel visits you booked on arsam.net.' : 'arsam.net üzerinde planladığın parsel görme randevuları.'}
>
  <AuthGuard />
  <AccountLayout active="randevular">
    <PageHeader
      eyebrow="HESAP · RANDEVULAR"
      title="Görme randevularım"
      description="Planladığın parsel ziyaretleri — onay/iptal/erteleme."
    />
    <ViewingsList client:idle />
  </AccountLayout>
</RootLayout>
