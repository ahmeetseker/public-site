---
import WizardLayout from '@/layouts/WizardLayout.astro'
import { t, detectLocaleFromPath } from '@/i18n'

const locale = detectLocaleFromPath(Astro.url.pathname)
// TODO i18n: wizard intro body stays TR-canonical.
// Wave F4 / Agent-F4A — landing page offers "Devam et" if a draft exists,
// else "Yeni başla" CTA. Resume detection runs client-side because the
// localStorage key (arsam.ilan-draft.v1) is browser-only.
---
<WizardLayout
  title={t('ilanVer.title', locale)}
  description={locale === 'en' ? 'Publish your land, field or olive grove on arsam.net in 5 minutes.' : 'Arsanı, tarlanı veya zeytinliğini 5 dakikada arsam.net üzerinde yayına gönder.'}
  step={0}
  locale={locale}
>
  <div class="text-center">
    <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
      İlan ver · ücretsiz · 5 dakika
    </div>
    <h1 class="mt-3 font-serif text-4xl font-normal tracking-tight md:text-5xl">
      İlan vermek için <em class="italic font-normal">5 dakika</em> ayır
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-sm text-muted-foreground md:text-base">
      Arsanı, tarlanı veya zeytinliğini doğru alıcıya ulaştır. 4 adımda; konum, özellikler, fiyat ve iletişim.
      Yayın öncesi her ilan ekibimizce incelenir.
    </p>

    <div
      id="ilan-ver-cta"
      class="mt-8 flex flex-wrap items-center justify-center gap-3"
      data-resume-cta=""
    >
      <a
        href="/ilan-ver/1"
        id="ilan-ver-primary"
        data-ilan-cta="start"
        class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-foreground px-5 py-3 text-sm font-medium text-background transition-opacity hover:opacity-90"
      >
        Başla
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <div class="mt-14 grid gap-4 md:grid-cols-3">
    <div class="rounded-2xl border border-border bg-card p-5">
      <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Aracısız</div>
      <h2 class="mt-2 font-serif text-lg font-normal tracking-tight">Doğrulanmış alıcılar</h2>
      <p class="mt-1 text-xs text-muted-foreground">arsam.net'te alıcılar profilleriyle, ofislerse lisanslarıyla görünür.</p>
    </div>
    <div class="rounded-2xl border border-border bg-card p-5">
      <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Yayın</div>
      <h2 class="mt-2 font-serif text-lg font-normal tracking-tight">Editör onayı</h2>
      <p class="mt-1 text-xs text-muted-foreground">Tüm ilanları yayından önce ekibimiz inceler; eksik bilgide geri döneriz.</p>
    </div>
    <div class="rounded-2xl border border-border bg-card p-5">
      <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Ücretsiz</div>
      <h2 class="mt-2 font-serif text-lg font-normal tracking-tight">Komisyon yok</h2>
      <p class="mt-1 text-xs text-muted-foreground">İlan vermek ücretsiz. Sadece anlaşma kapanırsa hizmet bedeli alınır.</p>
    </div>
  </div>

  <div class="mt-14 rounded-2xl border border-dashed border-border bg-card/40 p-5">
    <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Hazırlığın için</div>
    <h2 class="mt-2 font-serif text-lg font-normal tracking-tight">Bunları yanına hazırla</h2>
    <ul class="mt-3 space-y-1.5 text-sm text-muted-foreground">
      <li>· Tapu fotokopisi (yüklemeden okuyarak da girebilirsin)</li>
      <li>· Arazinin yaklaşık alanı (m²) ve cephe ölçüleri</li>
      <li>· En az 3 görsel — drone varsa daha iyi</li>
      <li>· Sana ulaşılacak telefon numarası</li>
    </ul>
  </div>

  <script is:inline>
    // Resume detection — read arsam.ilan-draft.v1 and inject "Devam et" + "Yeni başla"
    // CTAs if a draft is present. Runs only in the browser (Astro static build).
    try {
      const raw = localStorage.getItem('arsam.ilan-draft.v1')
      if (raw) {
        const parsed = JSON.parse(raw)
        const lastStep = parsed && typeof parsed.lastStep === 'number' ? parsed.lastStep : 1
        const resumeStep = Math.min(Math.max(lastStep, 1), 4)
        const ctaWrap = document.getElementById('ilan-ver-cta')
        const primary = document.getElementById('ilan-ver-primary')
        if (ctaWrap && primary) {
          // Repoint primary CTA to resume target.
          primary.setAttribute('href', '/ilan-ver/' + resumeStep)
          primary.textContent = 'Devam et'
          primary.appendChild(Object.assign(document.createElement('span'), {
            ariaHidden: 'true',
            textContent: ' →',
          }))
          primary.setAttribute('data-ilan-cta', 'resume')

          const fresh = document.createElement('button')
          fresh.type = 'button'
          fresh.className = 'inline-flex min-h-11 items-center gap-2 rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-medium text-muted-foreground transition hover:bg-foreground/5'
          fresh.textContent = 'Yeni başla'
          fresh.setAttribute('data-ilan-cta', 'fresh')
          fresh.addEventListener('click', function () {
            try { localStorage.removeItem('arsam.ilan-draft.v1') } catch {}
            // Also clear the legacy URL-state key from the previous wizard.
            try { localStorage.removeItem('arsam:ilan-ver:state') } catch {}
            location.href = '/ilan-ver/1'
          })
          ctaWrap.appendChild(fresh)
        }
      }
    } catch {}
  </script>
</WizardLayout>
