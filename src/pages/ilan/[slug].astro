---
/**
 * /ilan/[slug] — Komple ilan detay sayfası.
 *
 * Mockup: `komple_ilan_detay_sayfasi.html` birebir replikası.
 * 2 kolon (sol içerik / sağ sticky kart), inline statik bölümler.
 */

import RootLayout from '@/layouts/RootLayout.astro'
import MobileCtaBar from '@/components/listing/MobileCtaBar.tsx'
import StickyContactCard from '@/components/listing/StickyContactCard.astro'
import RecentTracker from '@/components/recent/RecentTracker'
import SocialProofToast from '@/components/social-proof/SocialProofToast'
import ShareButtons from '@/components/listing/ShareButtons.tsx'
import {
  MapPin, Eye, ChevronRight, BadgeCheck, Share2, Heart, Image as ImageIcon,
  Video, Mountain, Trees, Route, Map as MapIcon, Camera, Ruler, LayoutGrid,
  FileCheck2, ShieldCheck, Download, Activity, Waves, TreePine, Sun,
  Flame, Droplets, MountainSnow, PersonStanding, Bus, Bike, ShoppingCart,
  School, Stethoscope, Sailboat, TrendingUp, Calculator, Lightbulb, Receipt,
  BarChart3, Zap, Coins, Sparkles, ArrowUp, Pin, Star, Phone, MessageCircle,
} from '@landx/icons'
import '@/styles/print.css'

import { LISTINGS_V2 as LISTINGS } from '@landx/data'
import type { Listing } from '@landx/data'
import { formatTLCompact } from '@landx/ui/lib'
import { LOCALE_BCP47, detectLocaleFromPath } from '@/i18n'
import { placeholderDataUri } from '@/lib/placeholder-image'
import {
  realEstateListingSchema,
  breadcrumbListSchema,
  toJsonLd,
} from '@/lib/schema-builders'

const slugify = (s: string) =>
  s
    .toLocaleLowerCase('tr-TR')
    .replace(/[çğıöşü]/g, (c) => ({ ç: 'c', ğ: 'g', ı: 'i', ö: 'o', ş: 's', ü: 'u' })[c] || c)
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')

export function getStaticPaths() {
  const slugifyLocal = (s: string) =>
    s
      .toLocaleLowerCase('tr-TR')
      .replace(/[çğıöşü]/g, (c) => ({ ç: 'c', ğ: 'g', ı: 'i', ö: 'o', ş: 's', ü: 'u' })[c] || c)
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '')

  return LISTINGS.map((l) => ({
    params: { slug: `${slugifyLocal(l.title)}-${l.id}` },
    props: { listing: l },
  }))
}

interface Props {
  listing: Listing
}

const { listing } = Astro.props as Props
const slug = `${slugify(listing.title)}-${listing.id}`
const locale = detectLocaleFromPath(Astro.url.pathname)
const prefix = locale === 'en' ? '/en' : ''

const pageTitle = `${listing.title} · ${listing.district}, ${listing.city} — arsam.net`
const pageDescription = `${listing.size.toLocaleString(locale === 'en' ? 'en-US' : 'tr-TR')} m² ${listing.type}, ${listing.district}, ${listing.city}. ${formatTLCompact(listing.price)}. ${listing.tags.slice(0, 2).join(', ')}.`

const canonicalUrl = `https://arsam.net${prefix}/ilan/${slug}`
const shareText = `${listing.title} — ${formatTLCompact(listing.price)}`

const heroImageSrc = placeholderDataUri({
  seed: `${listing.id}-1`,
  label: listing.district,
  ratio: '4/3',
  size: 'md',
})

const baseListingSchema = realEstateListingSchema({
  name: listing.title,
  description: `${listing.district}, ${listing.city} — ${listing.size} m² ${listing.type}`,
  url: canonicalUrl,
  image: `https://arsam.net/og/listing-${listing.id}.jpg`,
  price: listing.price,
  priceCurrency: 'TRY',
  area: listing.size,
  city: listing.city,
  district: listing.district,
  latitude: listing.lat ?? undefined,
  longitude: listing.lng ?? undefined,
}) as Record<string, unknown>

const listingJsonLd: Record<string, unknown> = {
  ...baseListingSchema,
  inLanguage: LOCALE_BCP47[locale],
}
if (listingJsonLd.offers && typeof listingJsonLd.offers === 'object') {
  listingJsonLd.offers = {
    ...(listingJsonLd.offers as Record<string, unknown>),
    availability:
      listing.status === 'Aktif'
        ? 'https://schema.org/InStock'
        : 'https://schema.org/OutOfStock',
  }
}

const homeLabel = locale === 'en' ? 'Home' : 'Anasayfa'
const searchLabel = locale === 'en' ? 'Land search' : 'Arsa arama'
const breadcrumbJsonLd = breadcrumbListSchema([
  { name: homeLabel, url: `https://arsam.net${prefix}/` },
  { name: searchLabel, url: `https://arsam.net${prefix}/ara` },
  { name: listing.city, url: `https://arsam.net${prefix}/ara?il=${encodeURIComponent(listing.city)}` },
  { name: listing.district, url: canonicalUrl },
])

// Header pill içinde tıklanabilir breadcrumb — JSON-LD ile aynı seviyeler
const headerBreadcrumb = [
  { label: homeLabel, href: `${prefix}/` },
  { label: searchLabel, href: `${prefix}/ara` },
  { label: listing.city, href: `${prefix}/ara?il=${encodeURIComponent(listing.city)}` },
  { label: listing.district },
]

const unitPrice = Math.round(listing.price / listing.size)

// Gerçek görseller: listing.images varsa onları kullan; yoksa Picsum'dan
// listing.id seed'li deterministik foto seti. Build'de hash sabittir; CDN
// cache'lenir. 1 büyük + 4 thumb (toplam 5 göster, geri kalan "+N" overlay'de).
const galleryImages: string[] =
  listing.images && listing.images.length > 0
    ? listing.images
    : Array.from({ length: 24 }, (_, i) => `https://picsum.photos/seed/${listing.id}-${i + 1}/800/520`)
const photoCount = galleryImages.length
const heroPhoto = galleryImages[0]
const thumbPhotos = galleryImages.slice(1, 5)

// OpenStreetMap iframe embed — listing.lat/lng etrafında ~2km kare.
const lat = listing.lat ?? 39.92
const lng = listing.lng ?? 32.85
const bboxDelta = 0.01
const osmBbox = `${lng - bboxDelta},${lat - bboxDelta},${lng + bboxDelta},${lat + bboxDelta}`
const osmEmbedUrl = `https://www.openstreetmap.org/export/embed.html?bbox=${osmBbox}&layer=mapnik&marker=${lat},${lng}`
const osmFullUrl = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=15/${lat}/${lng}`

const similar = LISTINGS.filter((l) => l.id !== listing.id && l.city === listing.city).slice(0, 3)
const similarSlug = (l: Listing) => `${slugify(l.title)}-${l.id}`

const HAZARDS = [
  { icon: Activity, label: 'Deprem', value: 68, color: 'text-red-700' },
  { icon: Activity, label: 'Diri fay', value: 42, color: 'text-amber-700' },
  { icon: Flame, label: 'Yangın', value: 38, color: 'text-amber-700' },
  { icon: Droplets, label: 'Kuraklık', value: 24, color: 'text-emerald-700' },
  { icon: Waves, label: 'Sel', value: 12, color: 'text-emerald-700' },
  { icon: MountainSnow, label: 'Heyelan', value: 8, color: 'text-emerald-700' },
]

const POIS = [
  { icon: ShoppingCart, label: 'Çarşı & market', dist: '1.2 km · 3 dk' },
  { icon: School, label: 'İlkokul & ortaokul', dist: '1.8 km · 5 dk' },
  { icon: Stethoscope, label: 'Sağlık ocağı', dist: '2.4 km · 6 dk' },
  { icon: Sailboat, label: 'En yakın plaj', dist: '3.6 km · 8 dk' },
]

const APPT_DAYS = [
  { d: 'PZT', n: 18 }, { d: 'SAL', n: 19 }, { d: 'ÇAR', n: 20, on: true },
  { d: 'PER', n: 21 }, { d: 'CUM', n: 22 }, { d: 'CMT', n: 23 }, { d: 'PAZ', n: 24 },
]
---
<RootLayout title={pageTitle} description={pageDescription} breadcrumb={headerBreadcrumb}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://a.tile.openstreetmap.org" crossorigin />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  </Fragment>

  <script is:inline type="application/ld+json" set:html={toJsonLd(listingJsonLd)} />
  <script is:inline type="application/ld+json" set:html={toJsonLd(breadcrumbJsonLd)} />

  <RecentTracker
    client:idle
    slug={slug}
    title={listing.title}
    price={listing.price}
    image={heroImageSrc}
  />
  <SocialProofToast client:idle />

  <!-- Sayfa-içi breadcrumb kaldırıldı — üstteki navbar pill yeterli.
       Breadcrumb JSON-LD (SEO) hâlâ schema-builders'tan yayınlanıyor. -->

  <div class="mx-auto my-3 max-w-[1280px] rounded-2xl bg-muted/40 px-3 py-3 lg:my-5">

    <!-- 2 KOLON: SOL ANA (HERO + İÇERİK) / SAĞ STICKY -->
    <div class="grid grid-cols-1 gap-3.5 lg:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)] lg:items-start">

      <!-- LEFT MAIN -->
      <main class="min-w-0">

        <!-- HERO GALLERY (gerçek görseller, 220px) — main içinde -->
        <div class="mb-3 grid h-[220px] grid-cols-[1.6fr_1fr] gap-1.5">
          <div class="relative overflow-hidden rounded-lg bg-muted">
            <button type="button" data-open-gallery="0" aria-label="Galeriyi aç" class="absolute inset-0 z-[1] cursor-zoom-in"></button>
            <img src={heroPhoto} alt={listing.title} loading="eager" decoding="async" class="h-full w-full object-cover" />
            <div class="pointer-events-none absolute left-2.5 top-2.5 inline-flex items-center gap-1 rounded-full bg-white/95 px-2 py-1 text-[10px] font-medium">
              <BadgeCheck size={12} className="text-sky-700" />TKGM doğrulamalı
            </div>
            <div class="absolute right-2.5 top-2.5 z-[2] flex gap-1.5">
              <button type="button" data-share aria-label="Paylaş" class="flex h-[30px] w-[30px] items-center justify-center rounded-full bg-white/95 hover:bg-white"><Share2 size={15} /></button>
              <button type="button" data-fav aria-label="Kaydet" class="flex h-[30px] w-[30px] items-center justify-center rounded-full bg-white/95 hover:bg-white"><Heart size={15} /></button>
            </div>
            <div class="absolute bottom-2.5 left-2.5 z-[2] flex gap-1.5">
              <button type="button" data-open-gallery="0" class="inline-flex items-center gap-1 rounded-full bg-black/70 px-2.5 py-1 text-[10px] font-medium text-white hover:bg-black/85"><ImageIcon size={12} />Tümü · {photoCount}</button>
              <button type="button" data-toast="360° sanal tur yakında" data-toast-kind="warn" class="inline-flex items-center gap-1 rounded-full bg-black/70 px-2.5 py-1 text-[10px] font-medium text-white hover:bg-black/85">360°</button>
              <button type="button" data-toast="Video tur yakında" data-toast-kind="warn" class="inline-flex items-center gap-1 rounded-full bg-black/70 px-2.5 py-1 text-[10px] font-medium text-white hover:bg-black/85"><Video size={12} />Video</button>
            </div>
          </div>
          <div class="grid grid-cols-2 grid-rows-2 gap-1.5">
            {thumbPhotos.map((src, idx) => {
              const isLast = idx === thumbPhotos.length - 1
              const extra = Math.max(photoCount - 5, 0)
              return (
                <button type="button" data-open-gallery={idx + 1} aria-label={`Foto ${idx + 2}`} class="relative cursor-zoom-in overflow-hidden rounded-md bg-muted">
                  <img src={src} alt={`${listing.title} - foto ${idx + 2}`} loading="lazy" decoding="async" class="h-full w-full object-cover" />
                  {isLast && extra > 0 && (
                    <div class="absolute inset-0 flex items-center justify-center bg-black/55 text-sm font-medium text-white">+{extra}</div>
                  )}
                </button>
              )
            })}
          </div>
        </div>


        <!-- TITLE BLOCK (kompakt) -->
        <div class="mb-1 flex items-center gap-1.5 text-[11px] text-muted-foreground">
          <MapPin size={12} />
          <span>{listing.city} · {listing.district}</span><span>·</span>
          <span>No {listing.id.toUpperCase()}</span><span>·</span>
          <span class="inline-flex items-center gap-0.5"><Eye size={12} />{(listing.views ?? 50438).toLocaleString('tr-TR')}</span>
        </div>
        <h1 class="mb-1.5 text-[18px] font-medium leading-tight">{listing.title}</h1>
        <div class="mb-3 flex flex-wrap items-center gap-1.5">
          <span class="rounded-full bg-[#E1F5EE] px-2.5 py-0.5 text-[11px] font-medium text-[#085041]">Satılık</span>
          <span class="rounded-full border border-border bg-background px-2.5 py-0.5 text-[11px] font-medium">{listing.type}</span>
          {listing.tags.slice(0, 2).map((t) => (
            <span class="rounded-full border border-border bg-background px-2.5 py-0.5 text-[11px] font-medium">{t}</span>
          ))}
          <div class="ml-auto"><ShareButtons client:idle url={canonicalUrl} title={listing.title} text={shareText} /></div>
        </div>

        <!-- QUICK FACTS (4-col, 8 alan — kimlik tablosunu da içeriyor) -->
        <div class="grid grid-cols-2 gap-px overflow-hidden rounded-md border border-border bg-border md:grid-cols-4">
          <div class="flex flex-col gap-0.5 bg-background px-2.5 py-2">
            <span class="inline-flex items-center gap-1 text-[10px] text-muted-foreground"><Ruler size={11} />Yüzölçümü</span>
            <span class="text-[12px] font-medium">{listing.size.toLocaleString('tr-TR')} m²</span>
          </div>
          <div class="flex flex-col gap-0.5 bg-background px-2.5 py-2">
            <span class="inline-flex items-center gap-1 text-[10px] text-muted-foreground"><LayoutGrid size={11} />İmar</span>
            <span class="text-[12px] font-medium">{listing.zoning ?? 'Konut + ticaret'}</span>
          </div>
          <div class="flex flex-col gap-0.5 bg-background px-2.5 py-2">
            <span class="inline-flex items-center gap-1 text-[10px] text-muted-foreground"><FileCheck2 size={11} />Tapu</span>
            <span class="text-[12px] font-medium">{listing.titleStatus ?? 'Müstakil'}</span>
          </div>
          <div class="flex flex-col gap-0.5 bg-background px-2.5 py-2">
            <span class="inline-flex items-center gap-1 text-[10px] text-muted-foreground"><Route size={11} />Yola cephe</span>
            <span class="text-[12px] font-medium">{listing.hasRoad ? 'Asfalt · 22m' : 'Yok'}</span>
          </div>
          <div class="flex flex-col gap-0.5 bg-background px-2.5 py-2">
            <span class="text-[10px] text-muted-foreground">Ada / parsel</span>
            <span class="text-[12px] font-medium">3412 / 17</span>
          </div>
          <div class="flex flex-col gap-0.5 bg-background px-2.5 py-2">
            <span class="text-[10px] text-muted-foreground">TAKS / KAKS</span>
            <span class="text-[12px] font-medium">0.30 / 0.60</span>
          </div>
          <div class="flex flex-col gap-0.5 bg-background px-2.5 py-2">
            <span class="text-[10px] text-muted-foreground">Maks. kat</span>
            <span class="text-[12px] font-medium">2 kat · 7.50 m</span>
          </div>
          <div class="flex flex-col gap-0.5 bg-background px-2.5 py-2">
            <span class="text-[10px] text-muted-foreground">Altyapı</span>
            <span class="text-[12px] font-medium">Elektrik · su · gaz</span>
          </div>
        </div>

        <!-- TAB NAV (içerik-değiştiren, sahibinden tarzı; sticky DEĞİL, scroll ile birlikte hareket eder) -->
        <div
          id="listing-tabs"
          class="mt-4 flex gap-4 overflow-x-auto border-b border-border"
          role="tablist"
        >
          <button type="button" data-tab="genel" role="tab" aria-selected="true" class="tab-btn -mb-px whitespace-nowrap border-b-2 border-foreground py-1.5 text-[12px] font-medium">Genel</button>
          <button type="button" data-tab="konum" role="tab" aria-selected="false" class="tab-btn -mb-px whitespace-nowrap border-b-2 border-transparent py-1.5 text-[12px] text-muted-foreground hover:text-foreground">Konum &amp; risk</button>
          <button type="button" data-tab="cevre" role="tab" aria-selected="false" class="tab-btn -mb-px whitespace-nowrap border-b-2 border-transparent py-1.5 text-[12px] text-muted-foreground hover:text-foreground">Çevre</button>
          <button type="button" data-tab="yatirim" role="tab" aria-selected="false" class="tab-btn -mb-px whitespace-nowrap border-b-2 border-transparent py-1.5 text-[12px] text-muted-foreground hover:text-foreground">Yatırım</button>
          <button type="button" data-tab="gorusme" role="tab" aria-selected="false" class="tab-btn -mb-px whitespace-nowrap border-b-2 border-transparent py-1.5 text-[12px] text-muted-foreground hover:text-foreground">Görüşme</button>
        </div>

        <!-- GENEL: AÇIKLAMA + HUKUKİ ŞERH (yan yana) -->
        <section id="genel" role="tabpanel" class="tab-panel mt-4">
          <div class="grid grid-cols-1 gap-2.5 md:grid-cols-[1.4fr_1fr]">
            <div class="rounded-md border border-border bg-background px-3 py-2.5" data-expandable>
              <h2 class="mb-1 text-[13px] font-medium">Bu parsel hakkında</h2>
              <p class="text-[12px] leading-relaxed text-muted-foreground">
                {listing.district} merkeze 8 dk, asfalt yola sıfır cepheli {listing.size.toLocaleString('tr-TR')} m² imarlı parsel. {listing.zoning ?? 'Konut + ticaret'} planı; bağ evi / butik otel uygun. Şebeke altyapısı hazır. Son 12 ay çevre değer artışı %32.
                <span class="hidden" data-extra>
                  {' '}Parselin kuzey-doğu cephesi {listing.hasRoad ? '22 m asfalt yola' : 'mevcut yola'} açılır; güney cephesi bahçe yönlüdür. TAKBİS'te tek malik kaydı, 0 şerh kaydı bulunur. Çevre emsallerinde m² medyan fiyat ₺{Math.round(unitPrice * 1.1).toLocaleString('tr-TR')} olup, parselin birim fiyatı ₺{unitPrice.toLocaleString('tr-TR')}/m² ile emsalin altındadır. Belediye 1/1000 imar planına göre TAKS 0.30 / KAKS 0.60, maks. 2 kat (7.5 m) inşaat hakkı tanımlıdır. Elektrik, su ve doğalgaz şebekesi parsel sınırında hazır olup ek altyapı yatırımı gerekmez.
                </span>{' '}
                <button type="button" class="ml-1 font-medium text-sky-700 hover:underline" data-toggle-expand data-label-more="Devamını oku →" data-label-less="Daha az ↑">Devamını oku →</button>
              </p>
            </div>
            <div class="flex items-center gap-2.5 rounded-md border border-border bg-background px-3 py-2.5">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#E1F5EE]"><ShieldCheck size={18} className="text-[#085041]" /></div>
              <div class="min-w-0 flex-1">
                <div class="text-[12px] font-medium leading-tight">Tapu temiz · 0 şerh</div>
                <div class="text-[10px] leading-tight text-muted-foreground">TAKBİS 14.05.2026 · ipotek/haciz yok</div>
              </div>
              <button type="button" data-toast="Şerh raporu indiriliyor (TAKBİS PDF)" data-toast-kind="success" class="inline-flex items-center gap-1 rounded-md border border-border bg-transparent px-2 py-1 text-[11px] font-medium hover:bg-muted"><Download size={11} />PDF</button>
            </div>
          </div>
        </section>

        <!-- KONUM & RİSK (harita + 6 risk skor yan yana) -->
        <section id="konum" role="tabpanel" class="tab-panel mt-4 hidden">
          <div class="mb-1.5 flex items-center justify-between">
            <h2 class="text-[13px] font-medium">Konum &amp; risk</h2>
            <span class="text-[10px] text-muted-foreground">14 katman · AFAD · MTA · DSİ</span>
          </div>
          <div class="grid grid-cols-1 gap-2.5 md:grid-cols-[1.2fr_1fr]">
            <div>
              <div class="relative h-[180px] overflow-hidden rounded-md border border-border bg-muted">
                <div id="inline-map" class="absolute inset-0 z-0"></div>
                <button
                  type="button"
                  id="open-map-modal"
                  class="absolute bottom-1 right-1 z-[10] rounded bg-white/95 px-1.5 py-0.5 text-[9px] font-medium shadow hover:bg-white"
                >Büyük harita ⤢</button>
              </div>
              <div class="mt-1.5 flex flex-wrap gap-1">
                <button type="button" class="layer-chip rounded-full bg-foreground px-2 py-0.5 text-[10px] font-medium text-background" data-active="true" data-layer="parsel">Parsel</button>
                <button type="button" class="layer-chip rounded-full bg-foreground px-2 py-0.5 text-[10px] font-medium text-background" data-active="true" data-layer="imar">İmar</button>
                <button type="button" class="layer-chip rounded-full bg-muted px-2 py-0.5 text-[10px]" data-active="false" data-layer="diri-fay">Diri fay</button>
                <button type="button" class="layer-chip rounded-full bg-muted px-2 py-0.5 text-[10px]" data-active="false" data-layer="taskin">Taşkın</button>
                <button type="button" class="layer-chip rounded-full bg-muted px-2 py-0.5 text-[10px]" data-active="false" data-layer="orman">Orman</button>
                <!-- Ek 9 katman (toplam 14): tıklanınca açılır -->
                <button type="button" class="layer-chip hidden rounded-full bg-muted px-2 py-0.5 text-[10px]" data-active="false" data-layer="extra" data-extra-chip>Toprak sınıfı</button>
                <button type="button" class="layer-chip hidden rounded-full bg-muted px-2 py-0.5 text-[10px]" data-active="false" data-layer="extra" data-extra-chip>Eğim</button>
                <button type="button" class="layer-chip hidden rounded-full bg-muted px-2 py-0.5 text-[10px]" data-active="false" data-layer="extra" data-extra-chip>Yükselti</button>
                <button type="button" class="layer-chip hidden rounded-full bg-muted px-2 py-0.5 text-[10px]" data-active="false" data-layer="extra" data-extra-chip>Tarihi deprem</button>
                <button type="button" class="layer-chip hidden rounded-full bg-muted px-2 py-0.5 text-[10px]" data-active="false" data-layer="extra" data-extra-chip>Heyelan</button>
                <button type="button" class="layer-chip hidden rounded-full bg-muted px-2 py-0.5 text-[10px]" data-active="false" data-layer="extra" data-extra-chip>Yangın riski</button>
                <button type="button" class="layer-chip hidden rounded-full bg-muted px-2 py-0.5 text-[10px]" data-active="false" data-layer="extra" data-extra-chip>Yeraltı suyu</button>
                <button type="button" class="layer-chip hidden rounded-full bg-muted px-2 py-0.5 text-[10px]" data-active="false" data-layer="extra" data-extra-chip>Tarım sınıfı</button>
                <button type="button" class="layer-chip hidden rounded-full bg-muted px-2 py-0.5 text-[10px]" data-active="false" data-layer="extra" data-extra-chip>Altyapı</button>
