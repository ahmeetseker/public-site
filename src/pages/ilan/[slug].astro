  <script is:inline define:vars={{ lat, lng, zoning: listing.zoning ?? 'konut+ticari', sizeM2: listing.size, gallery: galleryImages, listingPrice: listing.price, listingTitle: listing.title }}>
    (function () {
      const root = document.getElementById('listing-tabs')
      if (!root) return
      const buttons = Array.from(root.querySelectorAll('.tab-btn'))
      const panels = Array.from(document.querySelectorAll('.tab-panel'))

      function activate(tab, scroll) {
        panels.forEach((p) => p.classList.toggle('hidden', p.id !== tab))
        buttons.forEach((b) => {
          const isActive = b.dataset.tab === tab
          b.setAttribute('aria-selected', isActive ? 'true' : 'false')
          b.classList.toggle('border-foreground', isActive)
          b.classList.toggle('border-transparent', !isActive)
          b.classList.toggle('font-medium', isActive)
          b.classList.toggle('text-muted-foreground', !isActive)
        })
        if (scroll) {
          // Tab nav'a smooth scroll — kullanıcı tab'a tıklayınca panel'i görmek için
          // tab nav'a otomatik kayar. Eğer zaten görünürse no-op.
          root.scrollIntoView({ behavior: 'smooth', block: 'start' })
        }
      }

      buttons.forEach((b) => {
        b.addEventListener('click', () => {
          const tab = b.dataset.tab
          if (tab) {
            activate(tab, true)
            history.replaceState(null, '', '#' + tab)
          }
        })
      })

      // Initial hash load — `#konum` gibi paylaşılan linkler için
      const initial = (location.hash || '').slice(1)
      if (initial && document.getElementById(initial)?.classList.contains('tab-panel')) {
        activate(initial, false)
        // Sayfa render olduktan sonra tab nav'a scroll yap
        setTimeout(() => root.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100)
      }
    })()

    // "Devamını oku" toggle
    document.querySelectorAll('[data-toggle-expand]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('[data-expandable]')
        const extra = card && card.querySelector('[data-extra]')
        if (!extra) return
        const wasHidden = extra.classList.contains('hidden')
        extra.classList.toggle('hidden')
        btn.textContent = wasHidden
          ? (btn.dataset.labelLess || 'Daha az ↑')
          : (btn.dataset.labelMore || 'Devamını oku →')
      })
    })

    // ============== LEAFLET HARİTA & KATMANLAR ==============
    // Layer aktif/pasif state — UI ve haritalar arasında ortak truth
    const layerState = {
      parsel: true, imar: true, 'diri-fay': false, taskin: false, orman: false,
    }

    // Bir Leaflet container kurar: tile + marker + tüm gerçek-koordinat overlay layer'lar
    function setupMap(elementId) {
      if (typeof L === 'undefined') return null
      const el = document.getElementById(elementId)
      if (!el || el._leafletInit) return el && el._leafletMap
      const map = L.map(el, { scrollWheelZoom: true }).setView([lat, lng], 16)
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap',
        maxZoom: 19,
      }).addTo(map)
      L.marker([lat, lng]).addTo(map)

      // Gerçek koordinatlara bağlı overlay layer'lar (harita ile birlikte hareket eder)
      const layers = {
        parsel: L.rectangle(
          [[lat - 0.0003, lng - 0.0004], [lat + 0.0003, lng + 0.0004]],
          { color: '#BA7517', weight: 2, fillOpacity: 0.22 }
        ).bindTooltip('Bu parsel · ' + sizeM2.toLocaleString('tr-TR') + ' m²', {
          permanent: true, direction: 'center', className: 'leaflet-tt-parsel',
        }),
        imar: L.rectangle(
          [[lat - 0.0009, lng - 0.0012], [lat + 0.0009, lng + 0.0012]],
          { color: '#0F6E56', weight: 1.5, dashArray: '5', fillOpacity: 0.08 }
        ).bindTooltip('İmar · ' + zoning, {
          permanent: true, direction: 'top', className: 'leaflet-tt-imar',
        }),
        'diri-fay': L.polyline(
          [[lat + 0.005, lng - 0.008], [lat - 0.003, lng + 0.012]],
          { color: '#A32D2D', weight: 3, dashArray: '7' }
        ).bindTooltip('Diri fay · 1.4 km', {
          permanent: true, sticky: true, className: 'leaflet-tt-fault',
        }),
        taskin: L.polygon(
          [[lat - 0.005, lng - 0.012], [lat - 0.005, lng + 0.012],
           [lat - 0.009, lng + 0.012], [lat - 0.009, lng - 0.012]],
          { color: '#185FA5', weight: 1, fillOpacity: 0.25 }
        ).bindTooltip('Taşkın yatağı', {
          permanent: true, direction: 'center', className: 'leaflet-tt-flood',
        }),
        orman: L.polygon(
          [[lat + 0.003, lng + 0.005], [lat + 0.003, lng + 0.015],
           [lat - 0.003, lng + 0.015], [lat - 0.003, lng + 0.007]],
          { color: '#0F6E56', weight: 1, fillOpacity: 0.18 }
        ).bindTooltip('Orman sınırı', {
          permanent: true, direction: 'center', className: 'leaflet-tt-forest',
        }),
      }

      // İlk state'e göre add
      Object.keys(layers).forEach((k) => {
        if (layerState[k]) layers[k].addTo(map)
      })

      el._leafletInit = true
      el._leafletMap = map
      el._leafletLayers = layers
      return map
    }

    // L global'i hazır olana kadar bekle
    function whenLeafletReady(cb) {
      if (typeof L !== 'undefined') return cb()
      let tries = 0
      const id = setInterval(() => {
        if (typeof L !== 'undefined' || tries++ > 60) {
          clearInterval(id)
          if (typeof L !== 'undefined') cb()
        }
      }, 100)
    }

    // Inline haritayı yükle
    whenLeafletReady(() => setupMap('inline-map'))

    // Chip toggle — chip görünüm + Leaflet layer add/remove (her iki harita)
    function applyLayerToMap(elementId, layer, active) {
      const el = document.getElementById(elementId)
      if (!el || !el._leafletMap || !el._leafletLayers) return
      const lyr = el._leafletLayers[layer]
      if (!lyr) return
      if (active && !el._leafletMap.hasLayer(lyr)) lyr.addTo(el._leafletMap)
      else if (!active && el._leafletMap.hasLayer(lyr)) el._leafletMap.removeLayer(lyr)
    }
    function setLayerActive(layer, active) {
      layerState[layer] = active
      document.querySelectorAll('.layer-chip[data-layer="' + layer + '"]').forEach((c) => {
        c.dataset.active = active ? 'true' : 'false'
        if (active) {
          c.classList.add('bg-foreground', 'text-background', 'font-medium')
          c.classList.remove('bg-muted')
        } else {
          c.classList.remove('bg-foreground', 'text-background', 'font-medium')
          c.classList.add('bg-muted')
        }
      })
      applyLayerToMap('inline-map', layer, active)
      applyLayerToMap('modal-map', layer, active)
    }
    document.querySelectorAll('.layer-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const layer = chip.dataset.layer
        if (!layer) return
        setLayerActive(layer, chip.dataset.active !== 'true')
      })
    })

    // Büyük harita modal aç/kapat (açılınca modal-map'i lazy init)
    const mapModal = document.getElementById('map-modal')
    const openMapBtn = document.getElementById('open-map-modal')
    function openMapModal() {
      if (!mapModal) return
      mapModal.classList.remove('hidden')
      mapModal.classList.add('flex')
      document.body.style.overflow = 'hidden'
      whenLeafletReady(() => {
        const el = document.getElementById('modal-map')
        if (!el) return
        if (!el._leafletInit) {
          setupMap('modal-map')
        }
        // Display:none'dan açılınca tile boyutları yanlış hesaplanır → fix
        setTimeout(() => el._leafletMap && el._leafletMap.invalidateSize(), 50)
      })
    }
    function closeMapModal() {
      if (!mapModal) return
      mapModal.classList.add('hidden')
      mapModal.classList.remove('flex')
      document.body.style.overflow = ''
    }
    if (openMapBtn) openMapBtn.addEventListener('click', openMapModal)
    document.querySelectorAll('[data-close-map-modal]').forEach((b) => {
      b.addEventListener('click', closeMapModal)
    })
    if (mapModal) {
      mapModal.addEventListener('click', (e) => {
        if (e.target === mapModal) closeMapModal()
      })
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mapModal && !mapModal.classList.contains('hidden')) {
        closeMapModal()
      }
    })

    // AI chat hızlı soru → input'a yaz, focus
    const chatInput = document.querySelector('[data-chat-input]')
    document.querySelectorAll('.ai-prompt').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!chatInput) return
        chatInput.value = btn.textContent.trim()
        chatInput.focus()
      })
    })

    // Harita "+9 katman" toggle — gizli ek chip'leri aç/kapa
    const extraBtn = document.getElementById('extra-layers-toggle')
    if (extraBtn) {
      let expanded = false
      extraBtn.addEventListener('click', () => {
        expanded = !expanded
        document.querySelectorAll('[data-extra-chip]').forEach((c) => {
          c.classList.toggle('hidden', !expanded)
        })
        extraBtn.textContent = expanded ? 'Daha az' : '+9 katman'
      })
    }

    // ============== TOAST + INTERACTION HANDLERS ==============
    // Toast root (DOM'a tek sefer eklenir)
    function ensureToastRoot() {
      let root = document.getElementById('toast-root')
      if (!root) {
        root = document.createElement('div')
        root.id = 'toast-root'
        root.className = 'fixed bottom-4 left-1/2 z-[200] flex -translate-x-1/2 flex-col gap-2 pointer-events-none'
        document.body.appendChild(root)
      }
      return root
    }
    function showToast(message, opts) {
      opts = opts || {}
      const root = ensureToastRoot()
      const toast = document.createElement('div')
      const bg = opts.kind === 'success'
        ? 'bg-emerald-700 text-white'
        : opts.kind === 'warn'
          ? 'bg-amber-700 text-white'
          : 'bg-foreground text-background'
      toast.className = 'pointer-events-auto rounded-md px-3 py-2 text-[12px] font-medium shadow-lg ' + bg
      toast.textContent = message
      root.appendChild(toast)
      setTimeout(() => {
        toast.style.transition = 'opacity 200ms, transform 200ms'
        toast.style.opacity = '0'
        toast.style.transform = 'translateY(8px)'
      }, 2400)
      setTimeout(() => toast.remove(), 2700)
    }

    // Generic [data-toast] click → just show the toast message
    document.querySelectorAll('[data-toast]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const kind = btn.dataset.toastKind || 'info'
        showToast(btn.dataset.toast, { kind })
      })
    })

    // Favori (kalp) toggle — sayfa bazında, basit visual state
    document.querySelectorAll('[data-fav]').forEach((btn) => {
      let active = false
      btn.addEventListener('click', () => {
        active = !active
        const icon = btn.querySelector('svg')
        if (icon) {
          if (active) {
            icon.style.fill = '#ef4444'
            icon.style.stroke = '#ef4444'
          } else {
            icon.style.fill = 'none'
            icon.style.stroke = 'currentColor'
          }
        }
        showToast(active ? 'Favorilere eklendi' : 'Favorilerden çıkarıldı', { kind: 'success' })
      })
    })

    // Paylaş (link kopyala) — navigator.share varsa onu kullan
    document.querySelectorAll('[data-share]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const url = location.href
        try {
          if (navigator.share) {
            await navigator.share({ title: document.title, url: url })
          } else if (navigator.clipboard) {
            await navigator.clipboard.writeText(url)
            showToast('Bağlantı kopyalandı', { kind: 'success' })
          } else {
            showToast(url)
          }
        } catch (e) { /* user cancelled */ }
      })
    })

    // Fiyat alarmı — radyo davranış (tek seçim aktif)
    const alarmBtns = document.querySelectorAll('[data-alarm]')
    alarmBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        alarmBtns.forEach((b) => {
          b.classList.remove('bg-foreground', 'text-background')
          b.classList.add('border', 'border-border', 'bg-transparent')
        })
        btn.classList.add('bg-foreground', 'text-background')
        btn.classList.remove('border', 'border-border', 'bg-transparent')
        showToast('Fiyat %' + btn.dataset.alarm + ' düşerse bildirim alacaksınız', { kind: 'success' })
      })
    })

    // Randevu gün — radyo davranış
    const dayBtns = document.querySelectorAll('[data-day]')
    dayBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        dayBtns.forEach((b) => {
          b.classList.remove('bg-foreground', 'text-background')
          b.classList.add('border', 'border-border', 'bg-transparent')
          const lbl = b.querySelector('div:first-child')
          if (lbl) {
            lbl.classList.remove('opacity-70')
            lbl.classList.add('text-muted-foreground')
          }
        })
        btn.classList.add('bg-foreground', 'text-background')
        btn.classList.remove('border', 'border-border', 'bg-transparent')
        const lbl = btn.querySelector('div:first-child')
        if (lbl) {
          lbl.classList.add('opacity-70')
          lbl.classList.remove('text-muted-foreground')
        }
        showToast(btn.dataset.dayLabel + ' günü seçildi')
      })
    })

    // ============== GALERİ LIGHTBOX ==============
    const galleryModal = document.getElementById('gallery-modal')
    const galleryImg = document.getElementById('gallery-img')
    const galleryCounter = document.getElementById('gallery-counter')
    let galleryIndex = 0
    function updateGalleryView() {
      if (!galleryImg || !galleryCounter || !gallery || gallery.length === 0) return
      galleryImg.src = gallery[galleryIndex]
      galleryImg.alt = (listingTitle || '') + ' - foto ' + (galleryIndex + 1)
      galleryCounter.textContent = (galleryIndex + 1) + ' / ' + gallery.length
    }
    function openGallery(idx) {
      if (!galleryModal) return
      galleryIndex = Math.max(0, Math.min(idx | 0, (gallery && gallery.length || 1) - 1))
      updateGalleryView()
      galleryModal.classList.remove('hidden')
      galleryModal.classList.add('flex')
      document.body.style.overflow = 'hidden'
    }
    function closeGallery() {
      if (!galleryModal) return
      galleryModal.classList.add('hidden')
      galleryModal.classList.remove('flex')
      document.body.style.overflow = ''
    }
    function prevGallery() {
      if (!gallery || gallery.length === 0) return
      galleryIndex = (galleryIndex - 1 + gallery.length) % gallery.length
      updateGalleryView()
    }
    function nextGallery() {
      if (!gallery || gallery.length === 0) return
      galleryIndex = (galleryIndex + 1) % gallery.length
      updateGalleryView()
    }
    document.querySelectorAll('[data-open-gallery]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault()
        openGallery(parseInt(el.getAttribute('data-open-gallery'), 10) || 0)
      })
    })
    document.querySelectorAll('[data-close-gallery]').forEach((b) => {
      b.addEventListener('click', closeGallery)
    })
    document.querySelectorAll('[data-gallery-prev]').forEach((b) => {
      b.addEventListener('click', prevGallery)
    })
    document.querySelectorAll('[data-gallery-next]').forEach((b) => {
      b.addEventListener('click', nextGallery)
    })
    if (galleryModal) {
      galleryModal.addEventListener('click', (e) => {
        if (e.target === galleryModal) closeGallery()
      })
    }
    document.addEventListener('keydown', (e) => {
      if (!galleryModal || galleryModal.classList.contains('hidden')) return
      if (e.key === 'Escape') closeGallery()
      else if (e.key === 'ArrowLeft') prevGallery()
      else if (e.key === 'ArrowRight') nextGallery()
    })

    // AI chat gönder — fake yanıt
    function sendChatMessage() {
      if (!chatInput) return
      const value = chatInput.value.trim()
      if (!value) {
        showToast('Önce bir soru yazın')
        return
      }
      chatInput.value = ''
      showToast('Yanıt hazırlanıyor...')
      setTimeout(() => {
        showToast('AI: "' + value.substring(0, 40) + (value.length > 40 ? '...' : '') + '" için yanıt geldi.', { kind: 'success' })
      }, 900)
    }
    document.querySelectorAll('[data-send-chat]').forEach((b) => {
      b.addEventListener('click', sendChatMessage)
    })
    if (chatInput) {
      chatInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault()
          sendChatMessage()
        }
      })
    }
  </script>
</RootLayout>
