---
import RootLayout from '@/layouts/RootLayout.astro'
import { t, detectLocaleFromPath } from '@/i18n'

const locale = detectLocaleFromPath(Astro.url.pathname)
// TODO i18n: contact-form labels are TR-canonical. Top-level chrome + title/desc migrated.

const subjects = [
  { value: 'genel', label: 'Genel soru' },
  { value: 'ofis-ortakligi', label: 'Ofis ortaklığı' },
  { value: 'basin', label: 'Basın iletişimi' },
  { value: 'hata', label: 'Hata bildirimi' },
  { value: 'diger', label: 'Diğer' },
]

const social = [
  { name: 'X', href: '#' },
  { name: 'LinkedIn', href: '#' },
  { name: 'Instagram', href: '#' },
]
---
<RootLayout
  title={t('contact.title', locale)}
  description={t('contact.description', locale)}
>
  <article class="mx-auto max-w-[1200px] px-4 py-12 lg:py-16">
    <header class="mb-10 max-w-[60ch]">
      <div class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">İLETİŞİM</div>
      <h1 class="font-serif text-4xl font-normal tracking-tight md:text-5xl">Bize <em class="font-serif italic font-normal">yazın</em></h1>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
        Form 24/7 açık. 2 iş günü içinde geri dönüyoruz. Aciliyse e-posta yöntemini tercih edin.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_320px]">
      <section aria-labelledby="form-title">
        <h2 id="form-title" class="sr-only">İletişim formu</h2>

        <form
          id="contact-form"
          method="POST"
          action="/_mock-contact"
          novalidate
          class="flex flex-col gap-5 rounded-2xl border border-border bg-card/40 p-6"
        >
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div class="flex flex-col gap-1.5">
              <label for="contact-name" class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Ad soyad <span class="text-foreground">*</span></label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                class="rounded-xl border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-accent"
                placeholder="Adınız soyadınız"
              />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="contact-email" class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">E-posta <span class="text-foreground">*</span></label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="rounded-xl border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-accent"
                placeholder="ornek@email.com"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div class="flex flex-col gap-1.5">
              <label for="contact-phone" class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Telefon <span class="text-muted-foreground/70">(opsiyonel)</span></label>
              <input
                id="contact-phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                class="rounded-xl border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-accent"
                placeholder="+90 5xx xxx xx xx"
              />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="contact-subject" class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Konu <span class="text-foreground">*</span></label>
              <select
                id="contact-subject"
                name="subject"
                required
                class="rounded-xl border border-border bg-background px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-accent"
              >
                {subjects.map((s) => (
                  <option value={s.value}>{s.label}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="contact-message" class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Mesaj <span class="text-foreground">*</span></label>
            <textarea
              id="contact-message"
              name="message"
              required
              minlength="20"
              maxlength="2000"
              rows="6"
              aria-describedby="contact-message-help"
              class="rounded-xl border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-accent"
              placeholder="Bize en az 20 karakter yazın. Konuyu net anlatırsanız daha hızlı dönebiliriz."
            />
            <div id="contact-message-help" class="text-xs text-muted-foreground">Min 20 / max 2000 karakter</div>
          </div>

          <div class="flex flex-col gap-3 border-t border-border pt-4">
            <label for="contact-kvkk" class="flex items-start gap-3 text-sm text-foreground">
              <input
                id="contact-kvkk"
                name="kvkk"
                type="checkbox"
                required
                class="mt-1 size-4 rounded border-border bg-background text-foreground focus:ring-2 focus:ring-accent"
              />
              <span>
                <strong>KVKK metnini okudum, onaylıyorum.</strong> İletişim verilerimin <a class="underline underline-offset-2" href="/kvkk">aydınlatma metni</a> kapsamında işlenmesine rıza gösteriyorum. <span class="text-foreground">*</span>
              </span>
            </label>
            <label for="contact-marketing" class="flex items-start gap-3 text-sm text-muted-foreground">
              <input
                id="contact-marketing"
                name="marketing"
                type="checkbox"
                class="mt-1 size-4 rounded border-border bg-background text-foreground focus:ring-2 focus:ring-accent"
              />
              <span>Yeni özellikler ve duyurular için pazarlama iletisi almayı kabul ediyorum (opsiyonel).</span>
            </label>
          </div>

          <div class="flex items-center justify-between gap-4 pt-2">
            <p class="text-xs text-muted-foreground"><em class="font-serif italic">*</em> alanlar zorunludur</p>
            <button
              type="submit"
              class="inline-flex items-center gap-2 rounded-full border border-border bg-foreground px-5 py-2 text-sm font-medium text-background transition hover:opacity-90"
            >
              Gönder →
            </button>
          </div>
        </form>

        <div
          id="contact-result"
          role="status"
          aria-live="polite"
          class="hidden mt-6 rounded-2xl border border-border bg-card p-6"
        >
          <div class="font-serif text-xl font-medium">Mesajın alındı.</div>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            <strong>Demo modu</strong> — gerçek mesajlaşma altyapısı Faz 12'de devreye girecek. Form göndermen kaydedilmedi, ama tasarım akışı tam olarak bu şekilde çalışacak. 2 iş günü içinde sana <a class="underline underline-offset-2" href="mailto:hello@arsam.net">hello@arsam.net</a> üzerinden geri döneceğiz.
          </p>
          <a href="/" class="mt-4 inline-flex items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium transition hover:bg-accent">
            ← Anasayfaya dön
          </a>
        </div>
      </section>

      <aside aria-label="İletişim bilgileri" class="flex flex-col gap-4">
        <div class="rounded-2xl border border-border bg-card p-5">
          <div class="font-serif text-lg font-medium tracking-tight">arsam<em class="italic font-normal text-muted-foreground">.net</em></div>
          <dl class="mt-4 flex flex-col gap-3 text-sm">
            <div>
              <dt class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Genel</dt>
              <dd class="mt-0.5"><a class="underline underline-offset-2" href="mailto:hello@arsam.net">hello@arsam.net</a></dd>
            </div>
            <div>
              <dt class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">KVKK</dt>
              <dd class="mt-0.5"><a class="underline underline-offset-2" href="mailto:kvkk@arsam.net">kvkk@arsam.net</a></dd>
            </div>
            <div>
              <dt class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Basın</dt>
              <dd class="mt-0.5"><a class="underline underline-offset-2" href="mailto:press@arsam.net">press@arsam.net</a></dd>
            </div>
            <div>
              <dt class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Adres</dt>
              <dd class="mt-0.5 text-muted-foreground">İstanbul, Türkiye <span class="text-foreground/60">(merkez ofis adresi Faz 2'de)</span></dd>
            </div>
          </dl>
        </div>

        <div class="rounded-2xl border border-border bg-card/40 p-5">
          <div class="mb-2 font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">SOSYAL</div>
          <ul class="flex flex-wrap gap-2 text-sm">
            {social.map((s) => (
              <li>
                <a href={s.href} class="inline-flex items-center gap-1 rounded-full border border-border bg-background px-3 py-1 transition hover:bg-accent" aria-label={`${s.name} (yakında)`}>
                  {s.name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-border bg-card/40 p-5">
          <div class="mb-1 font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">YANIT SÜRESİ</div>
          <p class="text-sm text-foreground">2 iş günü içinde geri dönüş</p>
          <p class="mt-1 text-xs text-muted-foreground">Acil bir konuysa doğrudan <a class="underline underline-offset-2" href="mailto:hello@arsam.net">hello@arsam.net</a></p>
        </div>

        <div class="rounded-2xl border border-border bg-card/40 p-5">
          <div class="mb-1 font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">DAHA HIZLI</div>
          <p class="text-sm leading-relaxed text-muted-foreground">
            Sorunuz <a class="underline underline-offset-2" href="/sss">SSS</a> sayfasında da olabilir — orada {/* eslint-disable-next-line */}cevabını bulamadığınız bir konu varsa formu kullanın.
          </p>
        </div>
      </aside>
    </div>
  </article>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.querySelector('#contact-form')
      const result = document.querySelector('#contact-result')
      if (!form || !result) return
      form.addEventListener('submit', (e) => {
        // Validate native constraints first (browser will show messages)
        if (!form.checkValidity()) {
          form.reportValidity()
          return
        }
        e.preventDefault()
        form.style.opacity = '0.5'
        form.style.pointerEvents = 'none'
        result.classList.remove('hidden')
        result.scrollIntoView({ behavior: 'smooth', block: 'center' })
      })
    })
  </script>
</RootLayout>
